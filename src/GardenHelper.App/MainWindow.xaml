<Window x:Class="GardenHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
        Title="Garden Helper" Height="880" Width="1520" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Icon="Assets/GardenHelper.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition/></Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,24,16,18">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SidebarSelectedBrush}" Margin="0,0,12,0">
                        <TextBlock Text="☘" FontFamily="{StaticResource SymbolFont}" FontSize="22" Foreground="{DynamicResource SidebarTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Garden Helper" FontFamily="Georgia" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:L nav_menu}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="10,1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="12,9" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Margin" Value="10,14,10,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarMutedBrush}" Margin="4,0,0,0"
                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource SymbolFont}" FontSize="16" Width="26" Foreground="{DynamicResource SidebarTextBrush}"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="14"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Border Padding="32,16,32,0">
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="560" HorizontalAlignment="Left" Width="560" Padding="38,9,12,9"
                             AutomationProperties.Name="{loc:L search_global}" ToolTip="{loc:L search_global_tip}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{loc:L set_language}">
                        <RadioButton Style="{StaticResource Segment}" GroupName="toplang" Content="EN" ToolTip="English" IsChecked="{Binding Language, Converter={StaticResource EqualsConv}, ConverterParameter=en}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="toplang" Content="RO" ToolTip="Română" IsChecked="{Binding Language, Converter={StaticResource EqualsConv}, ConverterParameter=ro}"/>
                    </StackPanel>
                    <TextBlock Text="⌕" FontFamily="{StaticResource SymbolFont}" FontSize="18" Foreground="{DynamicResource MutedBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="{loc:L search_placeholder}" Foreground="{DynamicResource MutedBrush}" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding Current}" IsTabStop="False"/>
        </Grid>
    </Grid>
</Window>
