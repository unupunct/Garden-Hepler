<UserControl x:Class="GardenHelper.App.Views.ComingUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{loc:L nav_comingup}" Style="{StaticResource H1}"/>
            <v:Banners Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                <TextBlock Text="{loc:L up_show}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Horizons}" SelectedItem="{Binding Horizon}" MinWidth="200" AutomationProperties.Name="{loc:L up_show}"/>
            </StackPanel>
            <TextBlock Text="{loc:L up_empty}" Style="{StaticResource Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14" Visibility="{Binding Now.Count, Converter={StaticResource HasValueVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:L up_now}" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Now}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Glyph, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Message, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="4,5" Cursor="Hand"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Title}">
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Glyph, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Date, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   "/><Run Text="{Binding Title, Mode=OneWay}"/></TextBlock>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="26,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
