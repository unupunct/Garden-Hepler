<UserControl x:Class="GardenHelper.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26" MaxWidth="760" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource PrimaryBrush}" Margin="0,0,16,0">
                            <TextBlock Text="☘" FontFamily="{StaticResource SymbolFont}" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Garden Helper" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Muted}"><Run Text="{loc:L about_version}"/><Run Text=" "/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{loc:L about_text}" Margin="0,16,0,0" LineHeight="22"/>
                    <TextBlock Text="{Binding ContentSummary}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="{loc:L about_github}" Command="{Binding OpenRepoCommand}" Margin="0,0,8,0"/>
                        <Button Content="{loc:L about_releases}" Command="{Binding OpenReleasesCommand}" Margin="0,0,8,0"/>
                        <Button Content="{loc:L set_open_data}" Command="{Binding OpenDataCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:L about_privacy_title}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{loc:L about_privacy}" Style="{StaticResource Muted}" Margin="0,6,0,0" LineHeight="22"/>
                    <TextBlock Text="{loc:L about_disclaimer_title}" Style="{StaticResource H2}" Margin="0,16,0,0"/>
                    <TextBlock Text="{loc:L about_disclaimer}" Style="{StaticResource Muted}" Margin="0,6,0,0" LineHeight="22"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:L about_third_party}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding License}" Style="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Use}" Style="{StaticResource Muted}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
