<UserControl x:Class="GardenHelper.App.Views.InteriorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <UserControl.Resources>
        <loc:InteriorKindName x:Key="KindName"/>
        <loc:CountToVisibility x:Key="CountVis"/>
        <DrawingBrush x:Key="FloorGrid" TileMode="Tile" Viewport="0,0,50,50" ViewportUnits="Absolute" Viewbox="0,0,50,50" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFDF7"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,50,50"/></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#22000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,2,2"/></GeometryDrawing.Geometry></GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="#FFFFFFFF" BorderBrush="#FFDCD3BC" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF8CAF64"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#FFD9ECC4"/><Setter TargetName="b" Property="BorderBrush" Value="#FF5F8F3E"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#FFFFFFFF" BorderBrush="#FFDCD3BC" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FFEFF5E4"/><Setter TargetName="b" Property="BorderBrush" Value="#FF8CAF64"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{loc:L nav_interior}" Style="{StaticResource H1}"/>
            <v:Banners Margin="0,6,0,0"/>
            <TextBlock Text="{loc:L int_none}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasBuilding, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
        </StackPanel>

        <Grid Grid.Row="1" Visibility="{Binding HasBuilding, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>

            <!-- tools -->
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,10,0" CornerRadius="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{loc:L int_building}" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding Buildings}" SelectedItem="{Binding Building}" AutomationProperties.Name="{loc:L int_building}"/>
                        <TextBlock Text="{loc:L int_floor}" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                        <ComboBox ItemsSource="{Binding Floors}" SelectedItem="{Binding Floor}" AutomationProperties.Name="{loc:L int_floor}"/>
                        <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding DrawWalls}" Margin="0,12,0,0" Padding="8,6" Content="{loc:L int_draw_walls}" ToolTip="{loc:L int_draw_help}" AutomationProperties.Name="{loc:L int_draw_walls}"/>
                        <TextBlock Text="{loc:L int_draw_help}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding Tools}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Label}"/>
                                        <ItemsControl ItemsSource="{Binding Kinds}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ToolButton}" Command="{Binding DataContext.AddKindCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            ToolTip="{Binding Key, Converter={StaticResource KindName}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Glyph}" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Key, Converter={StaticResource KindName}}" FontSize="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:L int_unplaced}" Style="{StaticResource Label}" Margin="0,6,0,0" Visibility="{Binding Unplaced.Count, Converter={StaticResource CountVis}}"/>
                        <ItemsControl ItemsSource="{Binding Unplaced}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding DataContext.PlacePlantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock FontSize="12"><Run Text="❀ "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- the floor plan -->
            <Grid Grid.Column="1" Margin="0,8,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#FFFCF1DC" BorderBrush="#FFE7C98E" BorderThickness="1" CornerRadius="12" Padding="10,6" Margin="0,0,0,8" Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Attention}" TextWrapping="Wrap"/>
                </Border>
                <Border Grid.Row="1" CornerRadius="16" BorderBrush="#FFDCD3BC" BorderThickness="1" Background="#FFEFE9D8" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="PlanScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnWheel" SizeChanged="OnViewportSize">
                            <Grid x:Name="World" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Margin="12">
                                <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/></Grid.LayoutTransform>
                                <Border Background="{StaticResource FloorGrid}" CornerRadius="14" BorderBrush="#FFCDBF98" BorderThickness="3">
                                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
                                </Border>
                                <Canvas IsHitTestVisible="False" Visibility="{Binding HasOutline, Converter={StaticResource BoolToVis}}">
                                    <Polygon Points="{Binding Outline}" Fill="#12B06A4A" Stroke="#66B06A4A" StrokeThickness="4" StrokeDashArray="6 4"/>
                                </Canvas>
                                <ItemsControl ItemsSource="{Binding Shapes}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="0.5,0.5" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Label}"
                                                  PreviewMouseLeftButtonDown="OnShapeDown">
                                                <Grid.RenderTransform><RotateTransform Angle="{Binding Rotation}"/></Grid.RenderTransform>
                                                <Border Background="{Binding Fill}" BorderBrush="{Binding Edge}" BorderThickness="2" CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="7" ShadowDepth="2" Opacity="0.2"/></Setter.Value></Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRoom}" Value="True"><Setter Property="Effect" Value="{x:Null}"/><Setter Property="CornerRadius" Value="14"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWall}" Value="True"><Setter Property="CornerRadius" Value="3"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOpening}" Value="True"><Setter Property="CornerRadius" Value="2"/><Setter Property="BorderThickness" Value="3"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRound}" Value="True"><Setter Property="CornerRadius" Value="500"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Needs}" Value="True"><Setter Property="BorderBrush" Value="#FFE3922B"/><Setter Property="BorderThickness" Value="5"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Due}" Value="True"><Setter Property="BorderBrush" Value="#FFD6453A"/><Setter Property="BorderThickness" Value="5"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#FFC0562B"/><Setter Property="BorderThickness" Value="5"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <Viewbox Stretch="Uniform" Margin="8" IsHitTestVisible="False" Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" FontSize="24" Foreground="#88333A2E" Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#FF2E3A2A" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Viewbox>
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,8,0,0" FontWeight="SemiBold" Foreground="#AA4A4130" IsHitTestVisible="False"
                                                           FontSize="{Binding DataContext.LabelSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding IsRoom, Converter={StaticResource BoolToVis}}"/>
                                                <Thumb Opacity="0" Cursor="SizeAll" DragStarted="OnMoveStart" DragDelta="OnMove" DragCompleted="OnMoveDone">
                                                    <Thumb.Style>
                                                        <Style TargetType="Thumb">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRoom}" Value="True"><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Height" Value="70"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Thumb.Style>
                                                </Thumb>
                                                <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="#FFC0562B" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                       Width="{Binding DataContext.HandleSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding DataContext.HandleSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       DragStarted="OnResizeStart" DragDelta="OnResize" DragCompleted="OnResizeDone">
                                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="50" BorderBrush="White" BorderThickness="2"/></ControlTemplate></Thumb.Template>
                                                </Thumb>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- wall drawing -->
                                <Canvas x:Name="DrawLayer" Background="#01000000" Cursor="Cross" Visibility="{Binding DrawWalls, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonDown="OnDrawDown" MouseMove="OnDrawMove" MouseLeftButtonUp="OnDrawUp">
                                    <Line x:Name="Rubber" Stroke="#FFC0562B" StrokeThickness="12" StrokeDashArray="2 1" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <!-- zoom -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Background="#EEFFFFFF" BorderBrush="#FFDCD3BC" BorderThickness="1" CornerRadius="18" Padding="6,3">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolButton}" Content="−" Command="{Binding ZoomOutCommand}" Margin="0,0,4,0" AutomationProperties.Name="{loc:L int_zoom_out}" ToolTip="{loc:L int_zoom_out}"/>
                                <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                                <Button Style="{StaticResource ToolButton}" Content="+" Command="{Binding ZoomInCommand}" Margin="4,0,4,0" AutomationProperties.Name="{loc:L int_zoom_in}" ToolTip="{loc:L int_zoom_in}"/>
                                <Button Style="{StaticResource ToolButton}" Content="{loc:L int_fit}" Command="{Binding ZoomFitCommand}" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- selected item -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12" Margin="10,8,0,0" CornerRadius="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{loc:L int_pick}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <StackPanel Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                            <TextBlock Text="{loc:L design_name}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding ItemName}"/>
                            <StackPanel Visibility="{Binding SelectedIsPlant, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:L int_plant}" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding PlantChoices}" SelectedItem="{Binding ItemPlant}"/>
                            </StackPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="X (cm)" Style="{StaticResource Label}"/><TextBox Text="{Binding ItemX}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Y (cm)" Style="{StaticResource Label}"/><TextBox Text="{Binding ItemY}"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{loc:L design_width}" Style="{StaticResource Label}"/><TextBox Text="{Binding ItemW}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{loc:L design_height}" Style="{StaticResource Label}"/><TextBox Text="{Binding ItemH}"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="°" Style="{StaticResource Label}"/><TextBox Text="{Binding ItemRot}" AutomationProperties.Name="{loc:L design_rotation}"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{loc:L int_notes}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding ItemNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="{loc:L save}" Command="{Binding SaveItemCommand}" Margin="0,0,6,6"/>
                                <Button Content="{loc:L int_rotate}" Command="{Binding RotateCommand}" Margin="0,0,6,6"/>
                                <Button Content="{loc:L int_duplicate}" Command="{Binding DuplicateCommand}" Margin="0,0,6,6"/>
                                <Button Style="{StaticResource DangerButton}" Content="{loc:L delete}" Command="{Binding DeleteCommand}" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>
                        <Button Content="{loc:L nav_inventory}" Command="{Binding OpenInventoryCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
