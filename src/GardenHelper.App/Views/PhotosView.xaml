<UserControl x:Class="GardenHelper.App.Views.PhotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,28">
                <TextBlock Text="{loc:L nav_photos}" Style="{StaticResource H1}"/>
                <TextBlock Text="{loc:L photos_sub}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <v:Banners Margin="0,8,0,0"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:L photos_add}" Command="{Binding ChooseCommand}" Padding="16,8" Margin="0,0,12,6"/>
                    <ComboBox ItemsSource="{Binding KindFilters}" SelectedItem="{Binding KindFilter}" MinWidth="170" Margin="0,0,10,6" AutomationProperties.Name="{loc:L photos_show}"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Tag="{loc:L photos_search}" AutomationProperties.Name="{loc:L photos_search}" Margin="0,0,10,6"/>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                </WrapPanel>

                <!-- adding a picture -->
                <Border Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}" Style="{StaticResource Card}" Padding="16" Margin="0,8,0,0" CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding PendingThumb}" Width="220" MaxHeight="220" Stretch="Uniform" Margin="0,0,16,0"/>
                        <StackPanel Width="380">
                            <TextBlock Text="{loc:L photos_caption}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:L photos_caption}"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{loc:L photos_about}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding NewKinds}" SelectedItem="{Binding NewKind}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{loc:L photos_which}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Owners}" SelectedItem="{Binding NewOwner}"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{loc:L photos_date}" Style="{StaticResource Label}"/>
                            <DatePicker SelectedDate="{Binding NewDate}" HorizontalAlignment="Left" Width="160"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="{loc:L save}" Command="{Binding SaveNewCommand}" Margin="0,0,8,0"/>
                                <Button Content="{loc:L photos_cancel}" Command="{Binding CancelNewCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Background="{DynamicResource TintGreenBrush}" CornerRadius="18" Padding="22" Margin="0,14,0,0">
                    <TextBlock Text="{loc:L photos_empty}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Tiles}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,12,12" Padding="0" AutomationProperties.Name="{Binding Caption}" ToolTip="{Binding About}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Width="216" ClipToBounds="True">
                                                            <StackPanel>
                                                                <Border Height="150" CornerRadius="16,16,0,0" ClipToBounds="True"><Image Source="{Binding Thumb}" Stretch="UniformToFill"/></Border>
                                                                <StackPanel Margin="10,6,10,8">
                                                                    <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding About}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{loc:L photos_more}" Command="{Binding ShowMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" Margin="0,12,0,12" Padding="18,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- big picture -->
        <Grid Visibility="{Binding Viewing, Converter={StaticResource HasValueVis}}" Background="#E6101810">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Image Source="{Binding ViewImage}" Margin="30" Stretch="Uniform"/>
            <Border Grid.Row="1" Background="#FF1C2619" Padding="20,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{loc:L delete}" Command="{Binding DeleteViewingCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L photos_close}" Command="{Binding CloseViewCommand}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Viewing.Caption}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Foreground="#FFB9C7AE"><Run Text="{Binding Viewing.About, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Viewing.DateText, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
