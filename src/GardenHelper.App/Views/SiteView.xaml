<UserControl x:Class="GardenHelper.App.Views.SiteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{loc:L nav_site}" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Text="{loc:L site_intro}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
            <v:Banners/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{loc:L site_lat}" Style="{StaticResource Label}" Margin="0,0,0,3"/><TextBox Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" Tag="46.7712" AutomationProperties.Name="{loc:L site_lat}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{loc:L site_lon}" Style="{StaticResource Label}" Margin="0,0,0,3"/><TextBox Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" Tag="23.6236" AutomationProperties.Name="{loc:L site_lon}"/></StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:L site_coord_help}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                    <TextBlock Text="{loc:L site_zoom}" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="zoom" Content="{loc:L site_zoom_wide}" IsChecked="{Binding Zoom, Converter={StaticResource EqualsConv}, ConverterParameter=17}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="zoom" Content="{loc:L site_zoom_normal}" IsChecked="{Binding Zoom, Converter={StaticResource EqualsConv}, ConverterParameter=18}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="zoom" Content="{loc:L site_zoom_close}" IsChecked="{Binding Zoom, Converter={StaticResource EqualsConv}, ConverterParameter=19}"/>
                    </StackPanel>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L site_calc_sun}" Command="{Binding CalculateSunCommand}" Margin="0,0,10,8"/>
                        <Button Content="{loc:L site_fetch}" Command="{Binding FetchOnlineCommand}" Margin="0,0,10,8"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:L site_online_note}" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding Satellite, Converter={StaticResource HasValueVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:L site_satellite}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <Image Source="{Binding Satellite}" MaxWidth="640" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="{loc:L site_satellite}"/>
                    <TextBlock Text="{Binding ScaleText}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Attribution}" Style="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock Text="{loc:L site_satellite_use}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasSun, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:L site_sun}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding BestText}" Margin="0,6,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:L site_col_month}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{loc:L site_col_sunrise}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{loc:L site_col_sunset}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="{loc:L site_col_day}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="{loc:L site_col_noon}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Sun}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Month}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sunrise}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Sunset}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DayLength}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Elevation}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:L site_sun_note}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasClimate, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:L site_climate}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding FrostText}" Margin="0,6,0,10"/>
                    <Button Content="{loc:L site_apply_frost}" Command="{Binding ApplyFrostCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="{Binding CanApplyFrost, Converter={StaticResource BoolToVis}}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:L site_col_month}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{loc:L site_col_min}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{loc:L site_col_max}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="{loc:L site_col_mean}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="{loc:L site_col_gdd}" Style="{StaticResource Muted}" FontWeight="SemiBold" ToolTip="{loc:L site_gdd_tip}"/>
                        <TextBlock Grid.Column="5" Text="{loc:L site_col_frost}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Months}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Month}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Min}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Max}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Mean}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Gdd}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding FrostDays}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:L site_climate_note}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
