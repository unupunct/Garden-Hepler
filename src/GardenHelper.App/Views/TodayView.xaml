<UserControl x:Class="GardenHelper.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="{loc:L today_welcome}" Style="{StaticResource H1}" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:L today_welcome_sub}" FontSize="16" Foreground="#FF5B6B50" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Greeting}" FontSize="13" Foreground="#FF8A9580" Margin="0,2,0,0"/>
            <UniformGrid Columns="4" Margin="0,14,0,0">
                <Border Background="#FFFFF0EA" BorderBrush="#FFEBC0AE" BorderThickness="1" CornerRadius="18" Padding="16,10" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding UrgentCount}" FontSize="30" FontWeight="Bold" Foreground="#FFB5472B"/><TextBlock Text="{loc:L today_t_urgent}" FontSize="12" Foreground="#FF7A4A3B"/></StackPanel></Border>
                <Border Background="White" BorderBrush="#FFE3DCC8" BorderThickness="1" CornerRadius="18" Padding="16,10" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding OpenCount}" FontSize="30" FontWeight="Bold"/><TextBlock Text="{loc:L today_t_open}" FontSize="12" Foreground="#FF6C7A62"/></StackPanel></Border>
                <Border Background="#FFEAF3FA" BorderBrush="#FFBBD5E8" BorderThickness="1" CornerRadius="18" Padding="16,10" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding WaterCount}" FontSize="30" FontWeight="Bold" Foreground="#FF2F6288"/><TextBlock Text="{loc:L today_t_water}" FontSize="12" Foreground="#FF3E5566"/></StackPanel></Border>
                <Border Background="#FFEFF6E6" BorderBrush="#FFCFE2BC" BorderThickness="1" CornerRadius="18" Padding="16,10"><StackPanel><TextBlock Text="{Binding RipeningCount}" FontSize="30" FontWeight="Bold" Foreground="#FF4C6E33"/><TextBlock Text="{loc:L today_t_ready}" FontSize="12" Foreground="#FF40552F"/></StackPanel></Border>
            </UniformGrid>
            <v:Banners Margin="0,8,0,0"/>
            <Button Content="{loc:L print_button}" Click="OnPrint" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,6" ToolTip="{loc:L print_tip}"/>

            <!-- at a glance: sun, weather, frost -->
            <UniformGrid Columns="3" Margin="0,14,0,0">
                <Border Background="#FFFFF7E3" BorderBrush="#FFEBD9A8" BorderThickness="1" CornerRadius="18" Padding="16,12" Margin="0,0,10,0" Visibility="{Binding HasSun, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:L today_sun}" FontWeight="SemiBold" Foreground="#FF8A6A1F"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="↑" FontSize="22" Foreground="#FFD9A21B" Margin="0,0,4,0"/><TextBlock Text="{Binding SunUp}" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="↓" FontSize="22" Foreground="#FFC9651B" Margin="18,0,4,0"/><TextBlock Text="{Binding SunDown}" FontSize="26" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SunDetail}" TextWrapping="Wrap" Foreground="#FF6C5B2E" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFEAF3FA" BorderBrush="#FFBBD5E8" BorderThickness="1" CornerRadius="18" Padding="16,12" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="{loc:L today_weather}" FontWeight="SemiBold" Foreground="#FF2F6288"/>
                        <StackPanel Visibility="{Binding HasWeather, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding WeatherNow}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" FontFamily="Segoe UI Emoji, Segoe UI"/>
                            <TextBlock Text="{Binding WeatherToday}" FontSize="12" Foreground="#FF3E5566" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding WeatherAge}" FontSize="11" Foreground="#FF7C8E9B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{loc:L today_wx_none}" TextWrapping="Wrap" FontSize="12" Foreground="#FF3E5566" Margin="0,6,0,0" Visibility="{Binding HasWeather, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <Button Content="{loc:L today_wx_update}" Command="{Binding UpdateWeatherCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5" ToolTip="{loc:L today_wx_privacy}"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFEFF6E6" BorderBrush="#FFCFE2BC" BorderThickness="1" CornerRadius="18" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{loc:L today_frost}" FontWeight="SemiBold" Foreground="#FF4C6E33"/>
                        <TextBlock Text="{Binding FrostText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasFrost, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{loc:L today_frost_none}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasFrost, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding DayCards}" Margin="0,8,0,0" Visibility="{Binding HasWeather, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#FFE3DCC8" BorderThickness="1" CornerRadius="14" Padding="6,8" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="12" Foreground="#FF6C7A62"/>
                                <TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" FontSize="22" FontFamily="Segoe UI Emoji"/>
                                <TextBlock Text="{Binding Range}" HorizontalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding Rain}" HorizontalAlignment="Center" FontSize="11" Foreground="#FF2F6288"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- nearly ready to harvest -->
            <Border Background="White" BorderBrush="#FFE3DCC8" BorderThickness="1" CornerRadius="18" Padding="16,12" Margin="0,12,0,0" Visibility="{Binding HasRipenings, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:L today_ripening}" FontWeight="SemiBold" FontSize="15"/>
                    <ItemsControl ItemsSource="{Binding Ripenings}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" CornerRadius="10" Padding="10,2" Margin="10,0,0,0">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#FFEFF3EA"/><Style.Triggers><DataTrigger Binding="{Binding Ready}" Value="True"><Setter Property="Background" Value="#FFD9ECC4"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding When}" FontSize="12" FontWeight="SemiBold" Foreground="#FF40552F"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding IsCalm, Converter={StaticResource BoolToVis}}" Background="#FFEFF6E6" BorderBrush="#FFCFE2BC" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,16,0,0">
                <TextBlock Text="{loc:L today_calm_text}" TextWrapping="Wrap" FontSize="15" Foreground="#FF40552F"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="16" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFE3DCC8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUrgent}" Value="True"><Setter Property="Background" Value="#FFFFF3EE"/><Setter Property="BorderBrush" Value="#FFEBC0AE"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontSize="22" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" IsEnabled="{Binding IsDone, Converter={StaticResource Not}}">
                                                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,0,6,0" Visibility="{Binding NeedsNumber, Converter={StaticResource BoolToVis}}"
                                                             ToolTip="{Binding NumberHint}" AutomationProperties.Name="{Binding NumberHint}"/>
                                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ActionLabel}" Padding="14,6"
                                                            Command="{Binding DataContext.DoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
