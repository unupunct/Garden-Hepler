<UserControl x:Class="GardenHelper.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Summary}" FontSize="16" Foreground="#FF5B6B50" Margin="0,2,0,0"/>
            <v:Banners Margin="0,8,0,0"/>

            <Border Visibility="{Binding IsCalm, Converter={StaticResource BoolToVis}}" Background="#FFEFF6E6" BorderBrush="#FFCFE2BC" BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,16,0,0">
                <TextBlock Text="{loc:L today_calm_text}" TextWrapping="Wrap" FontSize="15" Foreground="#FF40552F"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="16" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFE3DCC8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUrgent}" Value="True"><Setter Property="Background" Value="#FFFFF3EE"/><Setter Property="BorderBrush" Value="#FFEBC0AE"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" FontSize="22" FontFamily="Segoe UI Emoji" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" IsEnabled="{Binding IsDone, Converter={StaticResource Not}}">
                                                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="0,0,6,0" Visibility="{Binding NeedsNumber, Converter={StaticResource BoolToVis}}"
                                                             ToolTip="{Binding NumberHint}" AutomationProperties.Name="{Binding NumberHint}"/>
                                                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ActionLabel}" Padding="14,6"
                                                            Command="{Binding DataContext.DoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
