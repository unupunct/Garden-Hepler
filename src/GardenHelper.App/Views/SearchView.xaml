<UserControl x:Class="GardenHelper.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Margin="0,0,0,4"><Run Text="{loc:L search_title}"/><Run Text=": "/><Run Text="{Binding Query, Mode=OneWay}"/></TextBlock>
            <TextBlock Text="{loc:L search_hint}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
            <v:Banners/>
            <TextBlock Text="{loc:L search_none}" Style="{StaticResource Muted}" Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="14,10"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12"/>
                                                <TextBlock loc:Highlight.Text="{Binding Snippet}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
