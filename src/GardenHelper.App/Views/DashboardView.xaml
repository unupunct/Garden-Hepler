<UserControl x:Class="GardenHelper.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <UserControl.Resources>
        <Style x:Key="DashCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="390"/>
            <Setter Property="Margin" Value="0,0,18,18"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <DataTemplate x:Key="TaskLine">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Content="○" FontFamily="{StaticResource SymbolFont}" Padding="8,2" Margin="0,0,10,0" ToolTip="{loc:L task_complete}"
                        AutomationProperties.Name="{loc:L task_complete}"
                        Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}"/>
                    <TextBlock Text="{Binding DueDate, Converter={StaticResource DateConv}}" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26">
            <v:Banners/>
            <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}"/>
            <TextBlock Style="{StaticResource H1}" Margin="0,2,0,2" Text="{Binding Heading}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18" Text="{Binding SeasonText}"/>

            <!-- First-run guidance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding IsNewUser, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:L onboard_title}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{loc:L onboard_text}" Style="{StaticResource Muted}" Margin="0,6,0,14"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L onboard_garden}" Command="{Binding OpenGardenCommand}" Margin="0,0,10,8"/>
                        <Button Content="{loc:L onboard_library}" Command="{Binding OpenLibraryCommand}" Margin="0,0,10,8"/>
                        <Button Content="{loc:L onboard_plants}" Command="{Binding OpenPlantsCommand}" Margin="0,0,10,8"/>
                        <Button Content="{loc:L onboard_seeds}" Command="{Binding OpenSeedsCommand}" Margin="0,0,10,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <WrapPanel>
                <!-- Sowing windows -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:L dash_sow_now}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{loc:L dash_sow_estimate}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,10"/>
                        <StackPanel Visibility="{Binding HasFrostDate, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="{loc:L dash_need_frost}" Style="{StaticResource Muted}"/>
                            <Button Style="{StaticResource LinkButton}" Content="{loc:L onboard_garden}" Command="{Binding OpenGardenCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SowNow}" Visibility="{Binding HasFrostDate, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.OpenPlantCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PlantName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Activity}" Style="{StaticResource Muted}" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Window}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:L dash_nothing_now}" Style="{StaticResource Muted}"
                                   Visibility="{Binding SowNow.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                    </StackPanel>
                </Border>

                <!-- Next actions from the garden plan -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:L monitor_next}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding NextActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource SymbolFont}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock><Run Text="{Binding SeverityLabel, Mode=OneWay}" FontWeight="Bold"/><Run Text=" · "/><Run Text="{Binding Message, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:L dash_no_actions}" Style="{StaticResource Muted}" Visibility="{Binding NextActions.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource LinkButton}" Content="{loc:L dash_open_monitor}" Command="{Binding OpenMonitorCommand}" Margin="0,0,16,0"/>
                            <Button Style="{StaticResource LinkButton}" Content="{loc:L nav_designer}" Command="{Binding OpenDesignerCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Tasks -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:L dash_tasks}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:L task_overdue}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,4"
                                   Visibility="{Binding Overdue.Count, Converter={StaticResource HasValueVis}}"/>
                        <ItemsControl ItemsSource="{Binding Overdue}" ItemTemplate="{StaticResource TaskLine}"/>
                        <TextBlock Text="{loc:L task_today}" FontWeight="SemiBold" Margin="0,8,0,4"
                                   Visibility="{Binding Today.Count, Converter={StaticResource HasValueVis}}"/>
                        <ItemsControl ItemsSource="{Binding Today}" ItemTemplate="{StaticResource TaskLine}"/>
                        <TextBlock Text="{loc:L dash_no_tasks}" Style="{StaticResource Muted}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource NoItemsVis}">
                                    <Binding Path="Overdue.Count"/><Binding Path="Today.Count"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <Button Style="{StaticResource LinkButton}" Content="{loc:L dash_open_tasks}" Command="{Binding OpenTasksCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Library -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:L dash_library}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding LibraryText}" Style="{StaticResource Muted}" Margin="0,6,0,10"
                                   Visibility="{Binding HasBooks, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{loc:L dash_library_empty}" Style="{StaticResource Muted}" Margin="0,6,0,10"
                                   Visibility="{Binding HasBooks, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <StackPanel Visibility="{Binding LastBook, Converter={StaticResource HasValueVis}}" Margin="0,0,0,10">
                            <TextBlock Text="{loc:L dash_continue}" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding LastBook.Title}" FontWeight="SemiBold"/>
                            <Button Content="{loc:L dash_resume}" Command="{Binding ContinueReadingCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource LinkButton}" Content="{loc:L dash_open_library}" Command="{Binding OpenLibraryCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Seeds -->
                <Border Style="{StaticResource DashCard}" Visibility="{Binding SeedWarnings.Count, Converter={StaticResource HasValueVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:L dash_seed_warnings}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SeedWarnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="⚠" FontFamily="{StaticResource SymbolFont}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource LinkButton}" Content="{loc:L dash_open_seeds}" Command="{Binding OpenSeedsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Journal -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:L dash_journal}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding RecentJournal}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Date, Converter={StaticResource DateConv}}" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:L dash_journal_empty}" Style="{StaticResource Muted}"
                                   Visibility="{Binding RecentJournal.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                        <Button Style="{StaticResource LinkButton}" Content="{loc:L dash_open_journal}" Command="{Binding OpenJournalCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
