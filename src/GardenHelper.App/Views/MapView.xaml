<UserControl x:Class="GardenHelper.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>

        <TextBlock Text="{loc:L nav_map}" Style="{StaticResource H1}" FontSize="24" Grid.ColumnSpan="3"/>
        <v:Banners Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"/>

        <!-- Map -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" CornerRadius="10">
            <Grid x:Name="Surface" ClipToBounds="True" Background="#FF1E2A1E" Focusable="True"
                  MouseLeftButtonDown="OnDown" MouseMove="OnMove" MouseLeftButtonUp="OnUp" MouseRightButtonDown="OnRightDown" MouseWheel="OnWheel" SizeChanged="OnSize"
                  AutomationProperties.Name="{loc:L nav_map}">
                <Canvas x:Name="TileLayer" IsHitTestVisible="False"/>
                <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
                <Border Background="#E6FFFDF8" CornerRadius="10" Padding="22" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding MapEnabled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel>
                        <TextBlock Text="{loc:L map_offline_title}" Style="{StaticResource H2}" Foreground="#FF1F2A1C"/>
                        <TextBlock Text="{loc:L map_offline_note}" Foreground="#FF566350" Margin="0,6,0,14"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L map_load}" Command="{Binding LoadMapCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Background="#CCFFFFFF" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False">
                    <TextBlock FontSize="11" Foreground="#FF1F2A1C"><Run Text="{Binding Attribution, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding CursorText, Mode=OneWay}"/></TextBlock>
                </Border>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                    <Button Content="+" Command="{Binding ZoomInCommand}" ToolTip="{loc:L design_zoom_in}" AutomationProperties.Name="{loc:L design_zoom_in}" Padding="13,6" Margin="0,0,0,4"/>
                    <Button Content="−" Command="{Binding ZoomOutCommand}" ToolTip="{loc:L design_zoom_out}" AutomationProperties.Name="{loc:L design_zoom_out}" Padding="13,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Side panel -->
        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:L map_find}" Style="{StaticResource H2}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:L site_lat}" Style="{StaticResource Label}" Margin="0,0,0,3"/><TextBox Text="{Binding Latitude}" AutomationProperties.Name="{loc:L site_lat}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L site_lon}" Style="{StaticResource Label}" Margin="0,0,0,3"/><TextBox Text="{Binding Longitude}" AutomationProperties.Name="{loc:L site_lon}"/></StackPanel>
                        </Grid>
                        <Button Content="{loc:L map_go}" Command="{Binding GoToCoordinatesCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Places on the property -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:L map_places}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{loc:L map_places_help}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8"/>
                        <TextBlock Text="{loc:L map_add_structure}" Style="{StaticResource Label}" Margin="0,4,0,4"/>
                        <WrapPanel>
                            <Button Content="{loc:L feat_house}" Command="{Binding NewShapeCommand}" CommandParameter="house" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_workshop}" Command="{Binding NewShapeCommand}" CommandParameter="workshop" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_shed}" Command="{Binding NewShapeCommand}" CommandParameter="shed" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_barn}" Command="{Binding NewShapeCommand}" CommandParameter="barn" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_garage}" Command="{Binding NewShapeCommand}" CommandParameter="garage" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_other_structure}" Command="{Binding NewShapeCommand}" CommandParameter="other_structure" Padding="10,4" Margin="0,0,4,4"/>
                        </WrapPanel>
                        <TextBlock Text="{loc:L map_add_space}" Style="{StaticResource Label}" Margin="0,6,0,4"/>
                        <WrapPanel>
                            <Button Content="{loc:L feat_garden}" Command="{Binding NewShapeCommand}" CommandParameter="garden" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_greenhouse}" Command="{Binding NewShapeCommand}" CommandParameter="greenhouse" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_compost}" Command="{Binding NewShapeCommand}" CommandParameter="compost" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_orchard}" Command="{Binding NewShapeCommand}" CommandParameter="orchard" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_pond}" Command="{Binding NewShapeCommand}" CommandParameter="pond" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_free_land}" Command="{Binding NewShapeCommand}" CommandParameter="free_land" Padding="10,4" Margin="0,0,4,4"/>
                            <Button Content="{loc:L feat_other_space}" Command="{Binding NewShapeCommand}" CommandParameter="other_space" Padding="10,4" Margin="0,0,4,4"/>
                        </WrapPanel>
                        <Button Content="{loc:L map_add_outline}" Command="{Binding NewOutlineCommand}" HorizontalAlignment="Left" Padding="10,4" Margin="0,6,0,8" Visibility="{Binding HasOutline, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <TextBox Text="{Binding ShapeFilter, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:L map_filter}" AutomationProperties.Name="{loc:L map_filter}" Margin="0,4,0,6"/>
                        <ListBox ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}" MaxHeight="190" AutomationProperties.Name="{loc:L map_places}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}"><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Selected place -->
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{loc:L map_selected}" Style="{StaticResource H2}"/>
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:L design_name}" Style="{StaticResource Label}" Margin="0,8,0,3"/>
                            <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:L design_name}"/>
                            <TextBlock Text="{loc:L design_kind}" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" IsEnabled="{Binding CanOpenModule}"/>
                            <TextBlock Text="{loc:L space_notes}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Selected.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="{loc:L space_notes}"/>
                        </StackPanel>
                        <TextBlock Text="{loc:L map_instructions}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,8"/>
                        <TextBlock Text="{Binding PinsText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AreaText}" Margin="0,4,0,0"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource WarnBrush}" Margin="0,6,0,0" Visibility="{Binding WarningText, Converter={StaticResource HasValueVis}}"><Run Text="⚠ "/><Run Text="{Binding WarningText, Mode=OneWay}"/></TextBlock>
                        <ItemsControl ItemsSource="{Binding Pins}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" FontFamily="Segoe UI Symbol" FontSize="11" Padding="7,2" ToolTip="{loc:L map_pin_remove}" AutomationProperties.Name="{loc:L map_pin_remove}"
                                                Command="{Binding DataContext.RemovePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{loc:L map_add_center}" Command="{Binding AddPinAtCenterCommand}" Margin="0,0,6,6" ToolTip="{loc:L map_add_center_tip}"/>
                            <Button Content="{loc:L map_undo}" Command="{Binding UndoPinCommand}" Margin="0,0,6,6"/>
                            <Button Content="{loc:L map_clear}" Command="{Binding ClearPinsCommand}" Margin="0,0,6,6"/>
                            <Button Style="{StaticResource DangerButton}" Content="{loc:L map_delete_place}" Command="{Binding DeleteShapeCommand}" Margin="0,0,6,6"/>
                        </WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L map_open_module}" Command="{Binding OpenModuleCommand}" IsEnabled="{Binding CanOpenModule}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,0,0,12">
                    <Button Content="{loc:L map_save}" Command="{Binding SaveCommand}" Margin="0,0,6,6"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:L map_import}" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}" Margin="0,0,6,6"/>
                </WrapPanel>

                <Border Style="{StaticResource Card}" Padding="14" Visibility="{Binding TileProblem, Converter={StaticResource HasValueVis}}" Margin="0,0,0,12">
                    <TextBlock Foreground="{DynamicResource DangerBrush}"><Run Text="⚠ "/><Run Text="{Binding TileProblem, Mode=OneWay}"/></TextBlock>
                </Border>
                <TextBlock Text="{loc:L map_accuracy}" Style="{StaticResource Muted}" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
