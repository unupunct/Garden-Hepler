<UserControl x:Class="GardenHelper.App.Views.CamerasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{loc:L nav_cameras}" Style="{StaticResource H1}" Grid.ColumnSpan="3"/>
        <v:Banners Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"/>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}" Content="{loc:L cam_add}" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
            <TextBlock DockPanel.Dock="Top" Text="{loc:L cam_empty}" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding Cameras.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
            <ListBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{loc:L nav_cameras}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <Border Background="#FF111611" CornerRadius="8" MinHeight="260" MaxHeight="520">
                            <Grid>
                                <Image Source="{Binding Frame}" Stretch="Uniform" AutomationProperties.Name="{loc:L cam_picture}"/>
                                <TextBlock Text="{loc:L cam_no_picture}" Foreground="#FFBBC6B5" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20"
                                           Visibility="{Binding Frame, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding FrameNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{loc:L cam_test}" Command="{Binding TestCommand}" Margin="0,0,8,0"/>
                            <CheckBox Content="{loc:L cam_live}" IsChecked="{Binding Live}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{loc:L cam_live_tip}"/>
                            <Button Content="{loc:L cam_show_plan}" Command="{Binding ShowOnPlanCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{loc:L cam_settings}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{loc:L design_name}" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:L design_name}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:L cam_type}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding EditKind}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L cam_address}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditUrl}" Tag="http://192.168.1.50/snapshot.jpg" AutomationProperties.Name="{loc:L cam_address}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:L cam_address_help}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:L cam_user}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditUser}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L cam_password}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditPassword}" Tag="{loc:L cam_password_hint}" ToolTip="{loc:L cam_password_tip}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:L cam_place_title}" Style="{StaticResource H2}" Margin="0,16,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:L site_lat}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditLat}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L site_lon}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditLon}"/></StackPanel>
                        </Grid>
                        <Button Style="{StaticResource LinkButton}" Content="{loc:L cam_use_property}" Command="{Binding UsePropertyCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        <TextBlock Text="{loc:L cam_drag_hint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:L cam_heading}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditHeading}" ToolTip="{loc:L cam_heading_tip}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L cam_fov}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditFov}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="{loc:L cam_height}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditHeight}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:L cam_watches}" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding Places}" SelectedItem="{Binding EditPlace}"/>
                        <CheckBox Content="{loc:L cam_enabled}" IsChecked="{Binding EditEnabled}" Margin="0,10,0,0"/>
                        <TextBlock Text="{loc:L space_notes}" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding EditNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{loc:L save}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource DangerButton}" Content="{loc:L delete}" Command="{Binding DeleteCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
