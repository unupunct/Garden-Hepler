<UserControl x:Class="GardenHelper.App.Views.SpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,22,32,26" MaxWidth="1000" HorizontalAlignment="Left">
            <Button Style="{StaticResource LinkButton}" Content="{loc:L space_back}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Name}" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,12"><Run Text="{Binding KindLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding AreaText, Mode=OneWay}"/></TextBlock>
            <v:Banners/>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- What to do next -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:L space_next}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding NextText}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding NextText, Converter={StaticResource HasValueVis}}"/>
                            <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,5,0,6">
                                            <TextBlock><Run Text="{Binding Glyph, Mode=OneWay}" FontFamily="Segoe UI Symbol"/><Run Text=" "/><Run Text="{Binding SeverityLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Message, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,10,0,0" Visibility="{Binding HoldsPlantings, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource PrimaryButton}" Content="{loc:L space_plan}" Command="{Binding PlanInDesignerCommand}" Margin="0,0,8,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Growing: what is planted -->
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14" Visibility="{Binding HoldsPlantings, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{loc:L space_growing}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{loc:L space_no_plantings}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding Plantings.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                            <ItemsControl ItemsSource="{Binding Plantings}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock FontWeight="SemiBold"><Run Text="{Binding Plant, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Quantity, Mode=OneWay}"/></TextBlock>
                                                    <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="0"><TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"/></Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Expected}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding Expected, Converter={StaticResource HasValueVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Details and notes -->
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{loc:L space_details}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{loc:L design_name}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:L design_name}"/>
                            <TextBlock Text="{loc:L space_notes}" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" AutomationProperties.Name="{loc:L space_notes}"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="{loc:L save}" Command="{Binding SaveDetailsCommand}" Margin="0,0,8,0"/>
                                <Button Content="{loc:L space_edit_map}" Command="{Binding EditOnMapCommand}" Margin="0,0,8,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- History -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:L space_history}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{loc:L space_history_help}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding LogKinds}" SelectedItem="{Binding NewLogKind}" AutomationProperties.Name="{loc:L space_entry_type}"/>
                            <DatePicker Grid.Column="2" SelectedDate="{Binding NewLogDate}" AutomationProperties.Name="{loc:L journal_date}"/>
                        </Grid>
                        <TextBox Text="{Binding NewLogText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Margin="0,8,0,0"
                                 Tag="{loc:L space_entry_hint}" AutomationProperties.Name="{loc:L space_entry_hint}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L space_add_entry}" Command="{Binding AddLogCommand}" HorizontalAlignment="Left" Margin="0,8,0,10"/>
                        <TextBlock Text="{loc:L space_no_entries}" Style="{StaticResource Muted}" Visibility="{Binding Logs.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="12" Style="{StaticResource Muted}"><Run Text="{Binding DateText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding KindLabel, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                                <TextBlock Text="{Binding Log.Text}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕" FontFamily="Segoe UI Symbol" FontSize="11" Padding="7,2" VerticalAlignment="Top" ToolTip="{loc:L delete}" AutomationProperties.Name="{loc:L delete}"
                                                    Command="{Binding DataContext.DeleteLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
