<UserControl x:Class="GardenHelper.App.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{loc:L nav_connect}" Style="{StaticResource H1}"/>
            <v:Banners Margin="0,8,0,0"/>
            <TextBlock Text="{loc:L connect_intro}" TextWrapping="Wrap" Margin="0,8,0,12"/>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:L connect_server}" Style="{StaticResource H2}"/>
                    <WrapPanel>
                        <CheckBox Content="{loc:L connect_enable}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="{loc:L gh_port}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding Port}" Width="80" Margin="0,0,8,0" AutomationProperties.Name="{loc:L gh_port}"/>
                        <Button Content="{loc:L gh_apply}" Command="{Binding ApplyCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" Margin="0,6,0,0"/>
                    <TextBlock Text="{loc:L gh_security}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="{loc:L gh_token}" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Token, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{loc:L gh_token}"/>
                    <Button Content="{loc:L gh_new_token}" Command="{Binding NewTokenCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:L connect_phone}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{loc:L connect_phone_help}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:L connect_address}" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Addresses}" SelectedItem="{Binding Address}" MaxWidth="320" HorizontalAlignment="Left" AutomationProperties.Name="{loc:L connect_address}"/>
                    <TextBlock Text="{loc:L connect_link}" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding PhoneLink, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                    <Button Content="{loc:L gh_copy}" Command="{Binding CopyLinkCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    <TextBlock Text="{loc:L connect_qr}" Style="{StaticResource Label}"/>
                    <Border Background="White" Padding="6" HorizontalAlignment="Left" CornerRadius="6"><Image Source="{Binding PhoneQr}" Width="200" Height="200" AutomationProperties.Name="{loc:L connect_qr}"/></Border>
                    <TextBlock Text="{loc:L connect_remote}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Home Assistant" Style="{StaticResource H2}"/>
                    <TextBlock Text="{loc:L connect_ha_help}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding HomeAssistant, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" MaxHeight="260"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0" AutomationProperties.Name="Home Assistant"/>
                    <Button Content="{loc:L gh_copy}" Command="{Binding CopyHomeAssistantCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
