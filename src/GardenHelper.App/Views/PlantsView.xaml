<UserControl x:Class="GardenHelper.App.Views.PlantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <Grid Margin="32,26,32,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="{loc:L nav_plants}" Style="{StaticResource H1}" Grid.ColumnSpan="3" Margin="0,0,0,12"/>
        <v:Banners Grid.Row="1" Grid.ColumnSpan="3"/>

        <DockPanel Grid.Row="2">
            <TextBox DockPanel.Dock="Top" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:L plants_search}" Tag="{loc:L plants_search}" Margin="0,0,0,10"/>
            <ListBox DockPanel.Dock="Top" Style="{StaticResource ChipList}" ItemsSource="{Binding Purposes}" SelectedItem="{Binding SelectedPurpose}" DisplayMemberPath="Label"
                     AutomationProperties.Name="{loc:L plants_purpose}" Margin="0,0,0,6"/>
            <ListBox DockPanel.Dock="Top" Style="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label"
                     AutomationProperties.Name="{loc:L plants_category}"/>
            <TextBlock DockPanel.Dock="Top" Text="{loc:L plants_none}" Style="{StaticResource Muted}" Margin="2,4"
                       Visibility="{Binding Results.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock FontSize="12" Style="{StaticResource Muted}">
                                <Run Text="{Binding Scientific, Mode=OneWay}" FontStyle="Italic"/><Run Text="  ·  "/><Run Text="{Binding Category, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Empty state -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding Selected, Converter={StaticResource HasValueVis}, ConverterParameter=invert}">
            <StackPanel>
                <TextBlock Text="{loc:L plants_pick}" Style="{StaticResource H2}"/>
                <TextBlock Text="{loc:L plants_pick_text}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding Selected, Converter={StaticResource HasValueVis}}">
            <StackPanel>
                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding Selected.Scientific}" FontStyle="Italic" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                <Border Visibility="{Binding Caution, Converter={StaticResource HasValueVis}}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Background="{DynamicResource SurfaceBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontFamily="{StaticResource SymbolFont}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Caution}" MaxWidth="640"/>
                    </StackPanel>
                </Border>
                <TabControl>
                    <TabItem Header="{loc:L tab_overview}">
                        <StackPanel>
                            <TextBlock Text="{Binding Summary}" Margin="0,0,0,14" LineHeight="22"/>
                            <ItemsControl ItemsSource="{Binding Roles}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Badge}" Margin="0,0,6,6"><TextBlock Text="{Binding}" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Visibility="{Binding EdibilityText, Converter={StaticResource HasValueVis}}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold"><Run Text="{loc:L edib_title}"/><Run Text=": "/><Run Text="{Binding EdibilityText, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Text="{loc:L wild_mushroom_rule}" TextWrapping="Wrap" MaxWidth="640" Margin="0,4,0,0" Visibility="{Binding EdibilityText, Converter={StaticResource HasValueVis}}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ProtectedText}" TextWrapping="Wrap" MaxWidth="640" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="{Binding ProtectedText, Converter={StaticResource HasValueVis}}"/>
                            <StackPanel Visibility="{Binding Benefits, Converter={StaticResource HasValueVis}}" Margin="0,0,0,10">
                                <TextBlock Text="{loc:L plant_benefits}" Style="{StaticResource H2}" Margin="0,2,0,6"/>
                                <TextBlock Text="{Binding Benefits}" TextWrapping="Wrap" MaxWidth="640" LineHeight="22"/>
                            </StackPanel>
                            <Border Visibility="{Binding HasMedicinal, Converter={StaticResource BoolToVis}}" Style="{StaticResource Card}" Padding="14" Margin="0,4,0,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:L plant_medicinal}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{loc:L med_disclaimer}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" MaxWidth="640" Margin="0,2,0,8"/>
                                    <TextBlock Text="{loc:L med_parts}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MedParts}" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,6"/>
                                    <TextBlock Text="{loc:L med_uses}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MedUses}" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,6"/>
                                    <TextBlock Text="{loc:L med_safety}" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                                    <TextBlock Text="{Binding MedSafety}" TextWrapping="Wrap" MaxWidth="640"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{loc:L plant_tips}" Style="{StaticResource H2}" Margin="0,12,0,6"/>
                            <ItemsControl ItemsSource="{Binding Tips}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="•" Margin="0,0,8,0"/><TextBlock Text="{Binding}" MaxWidth="620"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:L plant_in_books}" Style="{StaticResource H2}" Margin="0,16,0,6"/>
                            <TextBlock Text="{loc:L plant_in_books_none}" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding NoBookHits, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding BookHits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="4,5" Cursor="Hand" AutomationProperties.Name="{Binding Book}"
                                                Command="{Binding DataContext.OpenBookHitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel MaxWidth="640">
                                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Book, Mode=OneWay}"/><Run Text="  ·  " FontWeight="Normal"/><Run Text="{Binding Section, Mode=OneWay}" FontWeight="Normal"/></TextBlock>
                                                <TextBlock Text="{Binding Snippet}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="{loc:L plant_add_seed}" Command="{Binding AddSeedCommand}" Margin="0,0,10,8"/>
                                <Button Content="{loc:L plant_find_library}" Command="{Binding FindInLibraryCommand}" Margin="0,0,10,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{loc:L tab_growing}">
                        <ItemsControl ItemsSource="{Binding Growing}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                    <TabItem Header="{loc:L tab_calendar}">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Background="{DynamicResource SurfaceBrush}">
                                <TextBlock Text="{Binding CalendarNote}"/>
                            </Border>
                            <TextBlock Text="{Binding SowingNote}" Style="{StaticResource Muted}" Margin="0,0,0,10" Visibility="{Binding SowingNote, Converter={StaticResource HasValueVis}}"/>
                            <Button Style="{StaticResource LinkButton}" Content="{loc:L onboard_garden}" Command="{Binding OpenGardenCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Visibility="{Binding CalendarPersonalized, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                            <StackPanel Visibility="{Binding CalendarPersonalized, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="◀ −1 w" Command="{Binding EarlierCommand}" ToolTip="{loc:L cal_earlier}" AutomationProperties.Name="{loc:L cal_earlier}" Margin="0,0,6,0"/>
                                    <Button Content="+1 w ▶" Command="{Binding LaterCommand}" ToolTip="{loc:L cal_later}" AutomationProperties.Name="{loc:L cal_later}" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource LinkButton}" Content="{loc:L cal_reset}" Command="{Binding ResetShiftCommand}" VerticalAlignment="Center"
                                            Visibility="{Binding ShiftDays, Converter={StaticResource HasValueVis}}"/>
                                    <TextBlock Text="{Binding ShiftDays, StringFormat={}{0:+#;-#;0} d}" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Windows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Activity}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Range}" Style="{StaticResource Muted}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{loc:L cal_add_task}" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.AddTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{loc:L tab_companions}">
                        <StackPanel>
                            <TextBlock Text="{loc:L comp_intro}" Style="{StaticResource Muted}" Margin="0,0,0,10" MaxWidth="640" HorizontalAlignment="Left"/>
                            <TextBlock Text="{loc:L comp_none}" Style="{StaticResource Muted}" Visibility="{Binding Companions.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                            <ItemsControl ItemsSource="{Binding Companions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8" MaxWidth="680" HorizontalAlignment="Left">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource LinkButton}" Content="{Binding OtherName}" FontWeight="SemiBold" FontSize="15" Margin="0,0,12,0"
                                                            Command="{Binding DataContext.OpenCompanionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Border Style="{StaticResource Badge}"><TextBlock FontSize="12"><Run Text="{loc:L comp_effect}"/><Run Text=": "/><Run Text="{Binding Effect, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                                                    <Border Style="{StaticResource Badge}"><TextBlock FontSize="12"><Run Text="{loc:L comp_evidence}"/><Run Text=": "/><Run Text="{Binding Evidence, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock></Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,4"/>
                                                <TextBlock Text="{Binding Explanation}"/>
                                                <TextBlock Text="{Binding Conditions}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding Conditions, Converter={StaticResource HasValueVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{loc:L tab_sources}">
                        <StackPanel>
                            <TextBlock Text="{Binding ConfidenceText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:L plant_sources_note}" Style="{StaticResource Muted}" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Selected.Plant.Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8" MaxWidth="640" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Title}"/>
                                            <TextBlock Text="{Binding Organization}" Style="{StaticResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
