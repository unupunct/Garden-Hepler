<UserControl x:Class="GardenHelper.App.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views"
             Focusable="True" PreviewKeyDown="OnKeyDown">
    <UserControl.Resources>
        <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,100,100" ViewportUnits="Absolute" Viewbox="0,0,100,100" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#FFF4F1E6">
                    <GeometryDrawing.Pen><Pen Brush="#2200000A" Thickness="1"/></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100"/></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid Margin="20,12,20,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

        <Popup IsOpen="{Binding CardOpen, Mode=TwoWay}" Placement="MousePoint" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="16" VerticalOffset="12">
            <Border Background="White" CornerRadius="16" BorderBrush="#FFDCD3BC" BorderThickness="1" Padding="16,14" Margin="14" MinWidth="290" MaxWidth="360">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28"/></Border.Effect>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCardCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Top" AutomationProperties.Name="Close" ToolTip="Close"/>
                        <TextBlock Text="{Binding Card.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FF1F2A1B"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Card.Subtitle}" FontStyle="Italic" Foreground="#FF6C7A62" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Card.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="#FF6C7A62" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#FFF1F6EA" CornerRadius="10" Padding="10,6" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:L card_sensors}" FontWeight="SemiBold" FontSize="12"/>
                            <ItemsControl ItemsSource="{Binding Card.Sensors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#FF6C7A62"/><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"/></Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Card.SensorsNote}" FontSize="12" Foreground="#FF6C7A62" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBox Text="{Binding CardNote, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:L card_note_ph}" AutomationProperties.Name="{loc:L card_note_ph}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Margin="0,12,0,0"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L card_log_water}" Command="{Binding LogCardCommand}" CommandParameter="water" Margin="0,0,6,6"/>
                        <Button Content="{loc:L card_harvested}" Command="{Binding LogCardCommand}" CommandParameter="harvest" Margin="0,0,6,6"/>
                        <Button Content="{loc:L card_problem}" Command="{Binding LogCardCommand}" CommandParameter="problem" Margin="0,0,6,6"/>
                        <Button Content="{loc:L card_add_note}" Command="{Binding LogCardCommand}" CommandParameter="note" Margin="0,0,6,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup IsOpen="{Binding AnimalCardOpen, Mode=TwoWay}" Placement="MousePoint" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="16" VerticalOffset="12">
            <Border Background="White" CornerRadius="16" BorderBrush="#FFDCD3BC" BorderThickness="1" Padding="16,14" Margin="14" MinWidth="290" MaxWidth="360">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28"/></Border.Effect>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseAnimalCardCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Top" AutomationProperties.Name="Close"/>
                        <TextBlock Text="{Binding AnimalCard.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FF1F2A1B"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding AnimalCard.Rows}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="#FF6C7A62" FontSize="12" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="13"/></Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding AnimalCard.Unit, Converter={StaticResource HasValueVis}}">
                        <TextBox Text="{Binding AnimalQty, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,8,0" ToolTip="{Binding AnimalCard.UnitLabel}" AutomationProperties.Name="{Binding AnimalCard.UnitLabel}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L today_a_LogProduction}" Command="{Binding LogAnimalProductionCommand}"/>
                    </StackPanel>
                    <Button Content="{loc:L today_a_OpenAnimals}" Command="{Binding OpenAnimalsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Needs a garden -->
        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasGarden, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel>
                <TextBlock Text="{loc:L design_need_garden}" Style="{StaticResource H2}"/>
                <TextBlock Text="{loc:L design_need_garden_text}" Style="{StaticResource Muted}" Margin="0,6,0,12"/>
                <WrapPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:L onboard_garden}" Command="{Binding OpenGardenCommand}" Margin="0,0,8,0"/>
                    <Button Content="{loc:L nav_site}" Command="{Binding OpenSiteCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Title + toolbar -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding HasGarden, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{loc:L nav_designer}" Style="{StaticResource H1}" FontSize="22" Margin="0,0,16,0" VerticalAlignment="Center"/>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="◧" FontFamily="{StaticResource SymbolFont}" Command="{Binding ToggleLeftCommand}" ToolTip="{loc:L design_toggle_left}" AutomationProperties.Name="{loc:L design_toggle_left}" Margin="0,0,10,4" Padding="10,5"/>
                    <Button Content="↶" FontFamily="{StaticResource SymbolFont}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="{Binding UndoTip}" AutomationProperties.Name="{loc:L design_undo}" Margin="0,0,4,4" Padding="10,5"/>
                    <Button Content="↷" FontFamily="{StaticResource SymbolFont}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip="{Binding RedoTip}" AutomationProperties.Name="{loc:L design_redo}" Margin="0,0,12,4" Padding="10,5"/>
                    <ToggleButton x:Name="PaletteToggle" IsChecked="{Binding PaletteOpen, Mode=TwoWay}" Margin="0,0,12,4" Padding="14,5" FontWeight="SemiBold"
                                  ToolTip="{loc:L pal_tip}" AutomationProperties.Name="{loc:L pal_add}">
                        <TextBlock><Run Text="＋ "/><Run Text="{loc:L pal_add}"/><Run Text=" ▾"/></TextBlock>
                    </ToggleButton>
                    <Popup IsOpen="{Binding PaletteOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=PaletteToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Style="{StaticResource Card}" Padding="14" Margin="6" MaxWidth="560">
                            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Palette}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="98" Height="62" Margin="0,0,6,6" Click="OnPaletteItem" AutomationProperties.Name="{Binding Label}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Glyph}" FontSize="20" HorizontalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                    <Button Content="−" Command="{Binding ZoomOutCommand}" ToolTip="{loc:L design_zoom_out}" AutomationProperties.Name="{loc:L design_zoom_out}" Margin="0,0,2,4" Padding="11,5"/>
                    <TextBlock Text="{Binding ScaleText}" VerticalAlignment="Center" Width="44" TextAlignment="Center" Margin="0,0,0,4"/>
                    <Button Content="+" Command="{Binding ZoomInCommand}" ToolTip="{loc:L design_zoom_in}" AutomationProperties.Name="{loc:L design_zoom_in}" Margin="2,0,4,4" Padding="11,5"/>
                    <Button Content="{loc:L design_fit}" Command="{Binding FitCommand}" ToolTip="{loc:L design_fit_tip}" Margin="0,0,10,4" Padding="10,5"/>
                    <CheckBox Content="{loc:L design_snap}" IsChecked="{Binding Snap}" VerticalAlignment="Center" Margin="0,0,14,4"/>
                    <CheckBox Content="{loc:L design_backdrop}" IsChecked="{Binding ShowBackdrop}" IsEnabled="{Binding HasBackdrop}" VerticalAlignment="Center" Margin="0,0,6,4" ToolTip="{loc:L design_backdrop_tip}"/>
                    <StackPanel Orientation="Horizontal" Margin="6,0,10,4" Visibility="{Binding HasBackdrop, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                        <Button Content="−" Command="{Binding BackdropLessCommand}" Padding="9,4" ToolTip="{loc:L sat_less}" AutomationProperties.Name="{loc:L sat_less}"/>
                        <TextBlock Text="{Binding BackdropOpacityText}" VerticalAlignment="Center" MinWidth="42" TextAlignment="Center"/>
                        <Button Content="+" Command="{Binding BackdropMoreCommand}" Padding="9,4" ToolTip="{loc:L sat_more}" AutomationProperties.Name="{loc:L sat_more}"/>
                    </StackPanel>
                    <Button Content="{loc:L design_backdrop_load}" Command="{Binding LoadBackdropCommand}" Padding="10,5" Margin="0,0,0,4" ToolTip="{loc:L design_backdrop_tip}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:L trace_start}" Command="{Binding StartTraceCommand}" Padding="10,5" Margin="8,0,0,4" ToolTip="{loc:L trace_help}"/>
                </WrapPanel>
            </Grid>
            <v:Banners Margin="0,6,0,0"/>
            <Border Visibility="{Binding Tracing, Converter={StaticResource BoolToVis}}" Background="#FFFFF4E0" BorderBrush="#FFE7C98E" BorderThickness="1" CornerRadius="14" Padding="12,8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:L trace_help}" TextWrapping="Wrap" FontSize="12" Foreground="#FF5B4A28"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBox Text="{Binding TraceName, UpdateSourceTrigger=PropertyChanged}" Width="220" Tag="{loc:L trace_name}" AutomationProperties.Name="{loc:L trace_name}" Margin="0,0,8,4"/>
                        <ComboBox ItemsSource="{Binding TraceKinds}" SelectedItem="{Binding TraceKind}" MinWidth="170" AutomationProperties.Name="{loc:L trace_kind}" Margin="0,0,8,4"/>
                        <TextBlock Text="{Binding TraceInfo}" VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <Button Content="{loc:L trace_undo}" Command="{Binding UndoPinCommand}" Margin="0,0,6,4"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L trace_finish}" Command="{Binding FinishTraceCommand}" Margin="0,0,6,4"/>
                        <Button Content="{loc:L trace_cancel}" Command="{Binding CancelTraceCommand}" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Three panels -->
        <Grid Grid.Row="2" Visibility="{Binding HasGarden, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: month planner and beds -->
            <ScrollViewer Visibility="{Binding LeftOpen, Converter={StaticResource BoolToVis}}" Width="248" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:L design_plan_year}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" AutomationProperties.Name="{loc:L design_plan_year}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,0,2"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{loc:L design_month_activities}" Style="{StaticResource H2}" Margin="0,12,0,6"/>
                    <TextBlock Text="{loc:L design_month_none}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding MonthActivities.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                    <ItemsControl ItemsSource="{Binding MonthActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,5" FontSize="12" AutomationProperties.Name="{Binding Text}"
                                        Command="{Binding DataContext.OpenActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel><TextBlock Text="{Binding Text}" FontWeight="SemiBold"/><TextBlock Text="{Binding Dates}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:L design_places}" Style="{StaticResource H2}" Margin="0,12,0,6" Visibility="{Binding FeatureShapes.Count, Converter={StaticResource HasValueVis}}"/>
                    <ItemsControl ItemsSource="{Binding FeatureShapes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <Button HorizontalContentAlignment="Left" Padding="8,5" FontSize="12" AutomationProperties.Name="{Binding Name}" ToolTip="{loc:L design_plan_space}"
                                            Visibility="{Binding IsSpace, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.PlanSpaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="{Binding KindLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AreaText, Mode=OneWay}"/></TextBlock></StackPanel>
                                    </Button>
                                    <Border Padding="8,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding IsStructure, Converter={StaticResource BoolToVis}}" ToolTip="{loc:L design_structure_tip}">
                                        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="🔒 " FontFamily="Segoe UI Emoji"/><Run Text="{Binding KindLabel, Mode=OneWay}"/></TextBlock></StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:L design_beds}" Style="{StaticResource H2}" Margin="0,12,0,6"/>
                    <ItemsControl ItemsSource="{Binding Beds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,5" FontSize="12" AutomationProperties.Name="{Binding Name}"
                                        Command="{Binding DataContext.SelectBedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AreaText, Mode=OneWay}"/></TextBlock></StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- CENTER: canvas + status bar -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,6" Margin="0,8,0,0">
                    <WrapPanel>
                        <TextBlock Text="{Binding CursorText}" Style="{StaticResource Muted}" FontSize="12" MinWidth="170" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding BoundaryText}" FontSize="12" Margin="0,0,16,0" Visibility="{Binding HasBoundary, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusSelection}" FontSize="12" Margin="0,0,16,0"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource WarnBrush}" Visibility="{Binding OverlapText, Converter={StaticResource HasValueVis}}"><Run Text="⚠ "/><Run Text="{Binding OverlapText, Mode=OneWay}"/></TextBlock>
                    </WrapPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0" CornerRadius="10">
                    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Surface2Brush}"
                                  PreviewMouseWheel="OnWheel" SizeChanged="OnViewportSize" PreviewMouseDown="OnPanStart" PreviewMouseMove="OnPanMove" PreviewMouseUp="OnPanEnd">
                        <Grid x:Name="World" MouseMove="OnWorldMove">
                            <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/></Grid.LayoutTransform>
                            <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="{StaticResource GridBrush}"/>
                            <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" IsHitTestVisible="False" Visibility="{Binding BackdropVisible, Converter={StaticResource BoolToVis}}">
                                <Image Opacity="{Binding BackdropOpacity}" Source="{Binding Backdrop}" Canvas.Left="{Binding BackdropX}" Canvas.Top="{Binding BackdropY}" Width="{Binding BackdropW}" Height="{Binding BackdropH}" Stretch="Fill"/>
                            </Canvas>
                            <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" IsHitTestVisible="False" Visibility="{Binding HasBoundary, Converter={StaticResource BoolToVis}}">
                                <Polygon Points="{Binding BoundaryPoints}" Stroke="#FFD9A400" StrokeThickness="{Binding StrokeSize}" StrokeDashArray="5 3" StrokeLineJoin="Round" Fill="#18D9A400"/>
                            </Canvas>
                            <!-- Traced places from the map: permanent structures and garden spaces, at true position -->
                            <ItemsControl ItemsSource="{Binding FeatureShapes}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Polygon MouseLeftButtonDown="OnShapeClick" ToolTip="{Binding Name}" Cursor="Hand" Points="{Binding Points}" Fill="{Binding Fill}" Stroke="{Binding Stroke}" StrokeThickness="{Binding DataContext.StrokeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeLineJoin="Round"/>
                                            <Border Background="#D9FFFFFF" CornerRadius="4" Padding="6,1" SizeChanged="OnLabelSize" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding Name}" Foreground="#FF1B2418" FontWeight="SemiBold" TextWrapping="NoWrap"
                                                           FontSize="{Binding DataContext.LabelSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Beds}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Width}" Height="{Binding Height}" RenderTransformOrigin="0.5,0.5" AllowDrop="True"
                                              PreviewMouseLeftButtonDown="OnBedDown" PreviewMouseMove="OnBedHover" Drop="OnBedDrop" DragOver="OnBedDragOver" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding TipText}">
                                            <Grid.RenderTransform><RotateTransform Angle="{Binding Rotation}"/></Grid.RenderTransform>
                                            <Border Background="{Binding Fill}" BorderBrush="#FF2A3B26" BorderThickness="3" CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FFD9A400"/><Setter Property="BorderThickness" Value="7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#FFC0562B"/><Setter Property="BorderThickness" Value="8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <loc:BedPlantsLayer Markers="{Binding Markers}" Zoom="{Binding DataContext.Scale, RelativeSource={RelativeSource AncestorType=UserControl}}" ClipToBounds="True" IsHitTestVisible="False" Margin="3"/>
                                    <Thumb Opacity="0" Cursor="SizeAll" DragStarted="OnMoveStart" DragDelta="OnMove" DragCompleted="OnMoveDone"/>
                                            <Canvas IsHitTestVisible="False"><Border Canvas.Bottom="{Binding Height}" Canvas.Left="0" Background="#F2FFFFFF" BorderBrush="#33000000" BorderThickness="1" CornerRadius="10" Padding="8,3" IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Foreground="#FF1B2418" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                               FontSize="{Binding DataContext.LabelSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Run Text="{Binding Label, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding PlantsText}" Foreground="#FF2F3B2B" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="600"
                                                               FontSize="{Binding DataContext.LabelSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </StackPanel>
                                            </Border></Canvas>
                                            <Thumb Background="#FFC0562B" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                   Width="{Binding DataContext.HandleSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Height="{Binding DataContext.HandleSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   DragStarted="OnResizeStart" DragDelta="OnResize" DragCompleted="OnResizeDone" ToolTip="{loc:L design_resize}">
                                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3"/></ControlTemplate></Thumb.Template>
                                            </Thumb>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Badges}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnBadgeClick" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}" Cursor="Hand"
                                                Width="{Binding DataContext.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding DataContext.BadgeSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="{Binding DataContext.BadgeMargin, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Fill="#F2FFFFFF" Stroke="#FFB7A57A" StrokeThickness="2"><Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.3"/></Ellipse.Effect></Ellipse>
                                                        <Viewbox Margin="3"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji"/></Viewbox>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CameraMarkers}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Polygon Points="{Binding View}" Fill="#3329A3D9" Stroke="#9929A3D9" StrokeThickness="{Binding DataContext.StrokeSize, RelativeSource={RelativeSource AncestorType=UserControl}}" IsHitTestVisible="False"/>
                                            <Thumb Canvas.Left="{Binding HandleX}" Canvas.Top="{Binding HandleY}" Margin="{Binding DataContext.CameraHandleMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="{Binding DataContext.CameraHandleSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding DataContext.CameraHandleSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Cursor="Cross" ToolTip="{loc:L cam_turn_tip}" AutomationProperties.Name="{loc:L cam_turn_tip}"
                                                   DragStarted="OnCamTurnStart" DragDelta="OnCamTurn" DragCompleted="OnCamTurnDone">
                                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#FFFFFFFF" Stroke="#FF1F6F94" StrokeThickness="{Binding DataContext.StrokeSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/></ControlTemplate></Thumb.Template>
                                            </Thumb>
                                            <Thumb Cursor="Hand" AutomationProperties.Name="{Binding Name}" DragStarted="OnCameraDragStart" DragDelta="OnCameraDrag" DragCompleted="OnCameraDragDone"
                                                   Width="{Binding DataContext.CameraIconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Height="{Binding DataContext.CameraIconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Canvas.Left="{Binding DataContext.CameraIconOffset, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Canvas.Top="{Binding DataContext.CameraIconOffset, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   ToolTipOpening="OnCameraTip">
                                                <Thumb.ToolTip>
                                                    <StackPanel MaxWidth="320">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                        <Image Source="{Binding Preview}" Width="300" MaxHeight="200" Stretch="Uniform" Margin="0,4"/>
                                                        <TextBlock Text="{Binding PreviewNote}" FontSize="11" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{loc:L cam_hover_open}" FontSize="11" Opacity="0.7"/>
                                                    </StackPanel>
                                                </Thumb.ToolTip>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid>
                                                            <Ellipse Fill="#FF1F6F94" Stroke="White" StrokeThickness="{Binding DataContext.StrokeSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            <Viewbox Stretch="Uniform"><TextBlock Text="&#x25C9;" Foreground="White" Margin="7"/></Viewbox>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="#01000000" Cursor="Cross" Visibility="{Binding Tracing, Converter={StaticResource BoolToVis}}" MouseLeftButtonDown="OnTraceDown">
                                <Polygon Points="{Binding TraceShape}" Fill="#33C0562B" Stroke="#FFC0562B" StrokeThickness="{Binding StrokeSize}" IsHitTestVisible="False"/>
                                <ItemsControl ItemsSource="{Binding TracePins}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Fill="White" Stroke="#FFC0562B" StrokeThickness="{Binding DataContext.StrokeSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Width="{Binding DataContext.CameraHandleSize, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding DataContext.CameraHandleSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Margin="{Binding DataContext.CameraHandleMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- RIGHT: plant library / selected object -->
            <TabControl Grid.Column="3" SelectedIndex="{Binding PanelTab}" Padding="0,8,0,0">
                <TabItem Header="{loc:L design_tab_library}">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" Text="{Binding LibrarySearch, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:L plants_search}" AutomationProperties.Name="{loc:L plants_search}" Margin="0,0,0,8"/>
                        <ListBox DockPanel.Dock="Top" Style="{StaticResource ChipList}" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Label" AutomationProperties.Name="{loc:L plants_category}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:L design_library_hint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding Cards}" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Background="Transparent" MouseMove="OnCardMouseMove" Cursor="Hand" ToolTip="{loc:L design_drag_tip}">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{Binding Scientific}" FontStyle="Italic" Style="{StaticResource Muted}" FontSize="12"/>
                                        <WrapPanel Margin="0,5,0,0">
                                            <Border Style="{StaticResource Badge}" Margin="0,0,4,3"><TextBlock Text="{Binding Category}" FontSize="11"/></Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,4,3" Visibility="{Binding Sun, Converter={StaticResource HasValueVis}}"><TextBlock FontSize="11"><Run Text="☀ "/><Run Text="{Binding Sun, Mode=OneWay}"/></TextBlock></Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,4,3" Visibility="{Binding Spacing, Converter={StaticResource HasValueVis}}"><TextBlock FontSize="11"><Run Text="↔ "/><Run Text="{Binding Spacing, Mode=OneWay}"/></TextBlock></Border>
                                            <Border Style="{StaticResource Badge}" Margin="0,0,4,3" Visibility="{Binding Days, Converter={StaticResource HasValueVis}}"><TextBlock FontSize="11"><Run Text="◔ "/><Run Text="{Binding Days, Mode=OneWay}"/></TextBlock></Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Window}" FontSize="12" Visibility="{Binding Window, Converter={StaticResource HasValueVis}}"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="{loc:L design_add_to_bed}" FontSize="12" Padding="8,3" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.AddCardToSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="{loc:L design_profile}" FontSize="12" Padding="8,3"
                                                    Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{loc:L design_tab_object}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <StackPanel>
                                    <TextBlock Text="{loc:L design_pick}" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{loc:L design_pick_text}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{loc:L design_shortcuts}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                                    <TextBlock Text="{loc:L design_satellite_hint}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:L design_name}" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{loc:L design_kind}" Style="{StaticResource Label}"/>
                                        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Label"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{loc:L design_width}" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Width, UpdateSourceTrigger=LostFocus, StringFormat=0}"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L design_height}" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Height, UpdateSourceTrigger=LostFocus, StringFormat=0}"/></StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Label}"><Run Text="{loc:L design_rotation}"/><Run Text=": "/><Run Text="{Binding Selected.Rotation, Mode=OneWay, StringFormat=0}"/><Run Text="°"/></TextBlock>
                                        <WrapPanel>
                                            <Button Content="↺ −15°" Command="{Binding RotateCommand}" CommandParameter="-15" Padding="10,4" Margin="0,0,6,0" ToolTip="{loc:L design_rotate_ccw}" AutomationProperties.Name="{loc:L design_rotate_ccw}"/>
                                            <Button Content="↻ +15°" Command="{Binding RotateCommand}" CommandParameter="15" Padding="10,4" Margin="0,0,6,0" ToolTip="{loc:L design_rotate_cw}" AutomationProperties.Name="{loc:L design_rotate_cw}"/>
                                            <Button Content="90°" Command="{Binding RotateCommand}" CommandParameter="90" Padding="10,4"/>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Label}"><Run Text="{loc:L design_shade}"/><Run Text=": "/><Run Text="{Binding Selected.ShadePercent, Mode=OneWay}"/><Run Text=" %"/></TextBlock>
                                        <Slider Minimum="0" Maximum="90" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Selected.ShadePercent}" AutomationProperties.Name="{loc:L design_shade}"/>
                                        <TextBlock Text="{loc:L design_shade_help}" Style="{StaticResource Muted}" FontSize="12"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="{loc:L save}" Command="{Binding SaveSelectedCommand}" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource DangerButton}" Content="{loc:L delete}" Command="{Binding DeleteSelectedCommand}"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{loc:L design_zoom_here}" Command="{Binding ZoomToSelectedCommand}" Margin="0,0,8,0" ToolTip="{loc:L design_zoom_here_tip}"/>
                                            <Button Content="{loc:L design_duplicate}" Command="{Binding DuplicateSelectedCommand}" Margin="0,0,8,0"/>
                                            <Button Content="{Binding Selected.LockLabel}" Command="{Binding ToggleLockCommand}" ToolTip="{loc:L design_lock_tip}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14" Visibility="{Binding BedAlerts.Count, Converter={StaticResource HasValueVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:L design_next}" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding BedAlerts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,4,0,6">
                                                        <TextBlock><Run Text="{Binding Glyph, Mode=OneWay}" FontFamily="Segoe UI Symbol"/><Run Text=" "/><Run Text="{Binding SeverityLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Message, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock Text="{Binding Why}" Style="{StaticResource Muted}" FontSize="12"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:L design_plantings}" Style="{StaticResource H2}"/>
                                        <TextBlock Text="{loc:L design_no_plantings}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding Plantings.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
                                        <ItemsControl ItemsSource="{Binding Plantings}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Viewbox Width="24" Height="24" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Data="{Binding IconBody}" Fill="{Binding IconBodyBrush}"/><Path Data="{Binding IconAccent}" Fill="{Binding IconAccentBrush}"/></Canvas></Viewbox>
                                                                    <TextBlock FontWeight="SemiBold"><Run Text="{Binding PlantName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Quantity, Mode=OneWay}"/></TextBlock>
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="0"><TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"/></Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Expected}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding Expected, Converter={StaticResource HasValueVis}}"/>
                                                            <WrapPanel Margin="0,6,0,0">
                                                                <Button Content="{loc:L status_Sown}" FontSize="12" Padding="8,3" Margin="0,0,4,4" Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SownArg}"/>
                                                                <Button Content="{loc:L status_Growing}" FontSize="12" Padding="8,3" Margin="0,0,4,4" Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding GrowingArg}"/>
                                                                <Button Content="{loc:L status_Harvesting}" FontSize="12" Padding="8,3" Margin="0,0,4,4" Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding HarvestingArg}"/>
                                                                <Button Content="{loc:L status_Finished}" FontSize="12" Padding="8,3" Margin="0,0,4,4" Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding FinishedArg}"/>
                                                                <Button Content="✕" FontFamily="Segoe UI Symbol" FontSize="12" Padding="8,3" ToolTip="{loc:L delete}" AutomationProperties.Name="{loc:L delete}" Command="{Binding DataContext.RemovePlantingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{loc:L design_add_plant}" Style="{StaticResource Label}" Margin="0,14,0,3"/>
                                        <ComboBox ItemsSource="{Binding Plants}" SelectedItem="{Binding NewPlant}" DisplayMemberPath="Name" AutomationProperties.Name="{loc:L design_add_plant}"/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{loc:L design_qty}" Style="{StaticResource Label}"/><TextBox Text="{Binding NewQuantity}"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L design_planted}" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding NewPlantedDate}"/></StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding FitText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" Visibility="{Binding FitText, Converter={StaticResource HasValueVis}}"/>
                                        <Button Style="{StaticResource LinkButton}" Content="{loc:L design_use_fit}" Command="{Binding UseFitQuantityCommand}" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding FitText, Converter={StaticResource HasValueVis}}"/>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0" Visibility="{Binding HasRotation, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"><Run Text="{loc:L design_rotation_check}"/></TextBlock>
                                                <TextBlock Margin="0,4,0,0"><Run Text="{Binding RotationGlyph, Mode=OneWay}" FontFamily="Segoe UI Symbol"/><Run Text=" "/><Run Text="{Binding RotationText, Mode=OneWay}"/></TextBlock>
                                                <TextBlock Text="{Binding RotationWhy}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="{loc:L add}" Command="{Binding AddPlantingCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
