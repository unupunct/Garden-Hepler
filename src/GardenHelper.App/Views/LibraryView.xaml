<UserControl x:Class="GardenHelper.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:L nav_library}" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding StatsText}" Style="{StaticResource Muted}" Margin="0,2,0,12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" IsEnabled="{Binding IsImporting, Converter={StaticResource Not}}">
                <Button Content="{loc:L lib_add_starter}" Command="{Binding AddStarterCommand}" Margin="0,0,8,0" ToolTip="{loc:L lib_add_starter_tip}"/>
                <Button Content="{loc:L lib_import_folder}" Command="{Binding BrowseFolderCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{loc:L lib_import}" Command="{Binding BrowseCommand}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <v:Banners/>
            <StackPanel Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                <ProgressBar Value="{Binding Progress}" Maximum="100"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Visibility="{Binding ImportProblems.Count, Converter={StaticResource HasValueVis}}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" VerticalAlignment="Top" Padding="9,2" Command="{Binding DismissProblemsCommand}" ToolTip="{loc:L lib_dismiss}" AutomationProperties.Name="{loc:L lib_dismiss}"/>
                    <StackPanel>
                        <TextBlock Text="{loc:L lib_import_problems}" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ImportProblems}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,3,0,0" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Empty state / drop zone -->
        <Border Grid.Row="4" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Padding="28">
            <StackPanel>
                <TextBlock Text="{loc:L lib_empty_title}" Style="{StaticResource H2}"/>
                <TextBlock Text="{loc:L lib_empty_text}" Style="{StaticResource Muted}" Margin="0,8,0,14" MaxWidth="640" HorizontalAlignment="Left"/>
                <ItemsControl ItemsSource="{Binding Formats}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Badge}" Margin="0,0,6,6"><TextBlock Text="{Binding}" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:L lib_privacy}" Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{loc:L lib_import}" Command="{Binding BrowseCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <TextBox Grid.Row="2" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="{loc:L lib_search}" Tag="{loc:L lib_search}"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" x:Name="SearchBox"/>
        <Grid Grid.Row="4" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <!-- The bookcase and the A-Z index (hidden while full-text search results are shown) -->
            <ScrollViewer x:Name="CaseScroll" VerticalScrollBarVisibility="Auto" SizeChanged="OnCaseSize" Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel>
                    <Border CornerRadius="8" Padding="18,16,18,10" BorderThickness="2" BorderBrush="#FF3B2616">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF6B4A30" Offset="0"/><GradientStop Color="#FF4E3420" Offset="1"/></LinearGradientBrush>
                        </Border.Background>
                        <ItemsControl ItemsSource="{Binding Shelves}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Border Background="#FF33200F" CornerRadius="3,3,0,0" Padding="4,0,4,0" Height="{Binding DataContext.ShelfHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ItemsControl ItemsSource="{Binding Spines}" VerticalAlignment="Bottom">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{Binding Width}" Height="{Binding Height}" Margin="0,0,3,0" VerticalAlignment="Bottom" CornerRadius="4,4,1,1" Background="{Binding Fill}" BorderBrush="#33FFFFFF" BorderThickness="1,1,0,0"
                                                                Cursor="Hand" Focusable="True" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="12000" AutomationProperties.Name="{Binding Title}"
                                                                MouseLeftButtonDown="OnSpineDown" RenderTransformOrigin="0.5,1">
                                                            <Border.ToolTip>
                                                                <StackPanel MaxWidth="320">
                                                                    <TextBlock Text="{Binding Row.Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Row.Author}" Opacity="0.8" TextWrapping="Wrap"/>
                                                                    <TextBlock Opacity="0.7" FontSize="11" Margin="0,3,0,0"><Run Text="{Binding Row.Format, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Row.Meta, Mode=OneWay}"/></TextBlock>
                                                                    <TextBlock Text="{loc:L lib_shelf_tip}" Opacity="0.6" FontSize="11" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Border.ToolTip>
                                                            <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#FFF3C969"/><Setter Property="BorderThickness" Value="3"/><Setter Property="Margin" Value="0,0,3,16"/></DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Margin" Value="0,0,3,8"/></Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <StackPanel Visibility="{Binding ShowBands, Converter={StaticResource BoolToVis}}">
                                                                    <Rectangle Height="5" Fill="#66F3C969" VerticalAlignment="Top" Margin="0,14,0,0"/>
                                                                    <Rectangle Height="5" Fill="#66F3C969" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                                                </StackPanel>
                                                                <Rectangle Height="4" Fill="#66F3C969" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                                                <TextBlock Text="{Binding Title}" Foreground="#FFF6EEDC" FontWeight="SemiBold" FontSize="{Binding FontSize}" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}"
                                                                           Width="{Binding TextLength}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" TextAlignment="Center">
                                                                    <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <Border Height="16" CornerRadius="0,0,3,3" BorderBrush="#FF2A1A0C" BorderThickness="0,1,0,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFB8855A" Offset="0"/><GradientStop Color="#FF8A5E3A" Offset="1"/></LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.45"/></Border.Effect>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}">
                        <Button Content="◀" Padding="14,4" Command="{Binding PreviousPageCommand}" ToolTip="{loc:L lib_prev_page}" AutomationProperties.Name="{loc:L lib_prev_page}"/>
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold" MinWidth="130" TextAlignment="Center"/>
                        <Button Content="▶" Padding="14,4" Command="{Binding NextPageCommand}" ToolTip="{loc:L lib_next_page}" AutomationProperties.Name="{loc:L lib_next_page}"/>
                    </StackPanel>
                    <TextBlock Text="{loc:L lib_all_titles}" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TitleFilter, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:L lib_find_title}" AutomationProperties.Name="{loc:L lib_find_title}"/>
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{loc:L lib_clear_filter}" Margin="10,0,0,0" Command="{Binding ClearTitleFilterCommand}"
                                Visibility="{Binding TitleFilter, Converter={StaticResource HasValueVis}}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding LetterBar}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Width="34" Height="30" Margin="0,0,4,4" Padding="0" FontWeight="SemiBold" AutomationProperties.Name="{Binding}"
                                        Command="{Binding DataContext.PickLetterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding IndexNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" Visibility="{Binding IndexNote, Converter={StaticResource HasValueVis}}"/>
                    <TextBlock Text="{loc:L lib_no_title_match}" Style="{StaticResource Muted}" Visibility="{Binding NoTitleMatches, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Letters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,6">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Letter}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Books}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="330" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="4,4" Margin="0,0,8,0" Cursor="Hand"
                                                        Click="OnIndexTitle" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Author}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Search results -->
            <DockPanel Grid.Column="0" Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="{loc:L lib_results}" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,8" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                <TextBlock DockPanel.Dock="Top" Text="{loc:L lib_no_hits}" Style="{StaticResource Muted}" Visibility="{Binding NoHits, Converter={StaticResource BoolToVis}}"/>
                <ListBox ItemsSource="{Binding Hits}" SelectionChanged="OnHitSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"><Run Text="{Binding BookTitle, Mode=OneWay}"/><Run Text="  ›  "/><Run Text="{Binding SectionTitle, Mode=OneWay}"/></TextBlock>
                                <TextBlock loc:Highlight.Text="{Binding Snippet}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Book details -->
            <Border Grid.Column="1" Width="360" Margin="22,0,0,0" Style="{StaticResource Card}" VerticalAlignment="Top">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource DetailsVis}">
                        <Binding Path="HasQuery"/><Binding Path="Selected"/>
                    </MultiBinding>
                </Border.Visibility>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                    <StackPanel>
                        <TextBlock Text="{loc:L lib_title}" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:L lib_author}" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding EditAuthor}"/>
                        <TextBlock Text="{loc:L lib_tags}" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding EditTags}"/>
                        <TextBlock Text="{Binding Selected.Book.Description}" Style="{StaticResource Muted}" Margin="0,12,0,0" MaxHeight="90"
                                   Visibility="{Binding Selected.Book.Description, Converter={StaticResource HasValueVis}}"/>
                        <TextBlock Text="{Binding Selected.Book.IndexMessage}" Foreground="{DynamicResource WarnBrush}" Margin="0,10,0,0"
                                   Visibility="{Binding Selected.Book.IndexMessage, Converter={StaticResource HasValueVis}}"/>
                        <TextBlock Text="{loc:L lib_book_subjects}" Style="{StaticResource Label}" Margin="0,14,0,4" Visibility="{Binding SelectedSubjects.Count, Converter={StaticResource HasValueVis}}"/>
                        <ItemsControl ItemsSource="{Binding SelectedSubjects}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,6,6" Padding="10,3" FontSize="12" Content="{Binding}" ToolTip="{loc:L lib_search_subject}"
                                            Command="{Binding DataContext.SearchSubjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0">
                            <Run Text="{Binding Selected.Book.OriginalFileName, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Selected.Book.SizeBytes, Converter={StaticResource BytesConv}, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Selected.Book.AddedUtc, Converter={StaticResource DateConv}, Mode=OneWay}"/>
                        </TextBlock>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{loc:L lib_read}" Command="{Binding ReadCommand}" Margin="0,0,8,8"/>
                            <Button Content="{loc:L save}" Command="{Binding SaveDetailsCommand}" Margin="0,0,8,8"/>
                            <Button Content="{loc:L lib_reindex}" Command="{Binding ReindexCommand}" ToolTip="{loc:L lib_reindex_tip}" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource DangerButton}" Content="{loc:L lib_remove}" Command="{Binding DeleteCommand}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
