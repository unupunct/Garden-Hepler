<UserControl x:Class="GardenHelper.App.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,20" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{loc:L nav_budget}" Style="{StaticResource H1}"/>
            <v:Banners Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                <Button Content="◀" Command="{Binding PrevCommand}" Padding="10,4" AutomationProperties.Name="{loc:L budget_prev}"/>
                <TextBlock Text="{Binding MonthLabel}" Style="{StaticResource H2}" Margin="14,0" VerticalAlignment="Center" MinWidth="150" TextAlignment="Center"/>
                <Button Content="▶" Command="{Binding NextCommand}" Padding="10,4" AutomationProperties.Name="{loc:L budget_next}"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="15" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:L budget_animals_note}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <ItemsControl ItemsSource="{Binding ByCategory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2" MaxWidth="360"><TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}"/></DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:L budget_add}" Style="{StaticResource H2}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="170"/><ColumnDefinition Width="8"/><ColumnDefinition Width="110"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{loc:L budget_date}" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding NewDate}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{loc:L budget_category}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="{loc:L budget_amount}" Style="{StaticResource Label}"/><TextBox Text="{Binding NewAmount}" AutomationProperties.Name="{loc:L budget_amount}"/></StackPanel>
                        <StackPanel Grid.Column="6"><TextBlock Text="{loc:L budget_text}" Style="{StaticResource Label}"/><TextBox Text="{Binding NewText}"/></StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="{loc:L budget_income}" IsChecked="{Binding NewIsIncome}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:L add}" Command="{Binding AddCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" AutomationProperties.Name="{loc:L delete}"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding Date, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Category, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
