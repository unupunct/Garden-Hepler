<UserControl x:Class="GardenHelper.App.Views.SeasonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <UserControl.Resources><loc:CountToVisibility x:Key="CountVis"/></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="{loc:L nav_season}" Style="{StaticResource H1}"/>
            <TextBlock Text="{loc:L season_sub}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            <v:Banners Margin="0,8,0,0"/>
            <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="{loc:L season_year}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" MinWidth="100" Margin="0,0,14,0" AutomationProperties.Name="{loc:L season_year}"/>
                <Button Content="{loc:L print_button}" Click="OnPrint" Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="{loc:L share_button}" Command="{Binding ShareCommand}" Padding="14,6" ToolTip="{loc:L share_tip}"/>
            </WrapPanel>
            <TextBlock Text="{Binding Title}" FontSize="22" FontFamily="Georgia" FontWeight="SemiBold" Margin="0,12,0,0"/>

            <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Background="#FFEFF6E6" CornerRadius="18" Padding="20" Margin="0,12,0,0">
                <TextBlock Text="{loc:L season_empty}" TextWrapping="Wrap" Foreground="#FF40552F"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#FFE3DCC8" BorderThickness="1" CornerRadius="18" Padding="16,10" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" Foreground="#FF2F5D3A"/><TextBlock Text="{Binding Label}" FontSize="12" Foreground="#FF6C7A62"/></StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Sections}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,8,0,0" CornerRadius="18">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{loc:L season_s_gallery}" Style="{StaticResource H2}" Margin="0,16,0,4" Visibility="{Binding Gallery.Count, Converter={StaticResource CountVis}}"/>
            <ItemsControl ItemsSource="{Binding Gallery}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="150" Margin="0,0,10,10" CornerRadius="14" ClipToBounds="True" Background="White" BorderBrush="#FFE3DCC8" BorderThickness="1" ToolTip="{Binding Caption}">
                            <StackPanel><Image Source="{Binding Thumb}" Height="100" Stretch="UniformToFill"/><TextBlock Text="{Binding Caption}" Margin="8,4,8,0" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DateText}" Margin="8,0,8,6" FontSize="10" Foreground="#FF8A9580"/></StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>