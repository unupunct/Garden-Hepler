<UserControl x:Class="GardenHelper.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="Row">
            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="{Binding Task.Done, Converter={StaticResource DoneGlyph}}" FontFamily="{StaticResource SymbolFont}" Padding="9,3" Margin="0,0,12,0"
                            ToolTip="{loc:L task_toggle}" AutomationProperties.Name="{loc:L task_toggle}"
                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Task.Title}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                            <Run Text="{Binding Task.DueDate, Converter={StaticResource DateConv}, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ActivityLabel, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Content="✕" FontFamily="{StaticResource SymbolFont}" ToolTip="{loc:L delete}" AutomationProperties.Name="{loc:L delete}"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{loc:L nav_tasks}" Style="{StaticResource H1}" Margin="0,0,0,14"/>
            <v:Banners/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:L task_new}" Margin="0,0,10,0">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Activities}" SelectedItem="{Binding NewActivity}" DisplayMemberPath="Label" Width="150" Margin="0,0,10,0"
                              AutomationProperties.Name="{loc:L task_activity}"/>
                    <DatePicker Grid.Column="2" SelectedDate="{Binding NewDue}" Margin="0,0,10,0" AutomationProperties.Name="{loc:L task_due}"/>
                    <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="{loc:L add}" Command="{Binding AddCommand}"/>
                </Grid>
            </Border>

            <TextBlock Text="{loc:L task_empty}" Style="{StaticResource Muted}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

            <TextBlock Text="⚠ " Visibility="Collapsed"/>
            <TextBlock Text="{loc:L task_overdue}" Style="{StaticResource H2}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"
                       Visibility="{Binding Overdue.Count, Converter={StaticResource HasValueVis}}"/>
            <ItemsControl ItemsSource="{Binding Overdue}" ItemTemplate="{StaticResource Row}"/>
            <TextBlock Text="{loc:L task_today}" Style="{StaticResource H2}" Margin="0,12,0,8" Visibility="{Binding Today.Count, Converter={StaticResource HasValueVis}}"/>
            <ItemsControl ItemsSource="{Binding Today}" ItemTemplate="{StaticResource Row}"/>
            <TextBlock Text="{loc:L task_upcoming}" Style="{StaticResource H2}" Margin="0,12,0,8" Visibility="{Binding Upcoming.Count, Converter={StaticResource HasValueVis}}"/>
            <ItemsControl ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource Row}"/>
            <TextBlock Text="{loc:L task_done}" Style="{StaticResource H2}" Margin="0,12,0,8" Visibility="{Binding Done.Count, Converter={StaticResource HasValueVis}}"/>
            <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource Row}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
