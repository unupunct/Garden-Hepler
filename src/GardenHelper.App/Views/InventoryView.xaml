<UserControl x:Class="GardenHelper.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{loc:L nav_inventory}" Style="{StaticResource H1}" Grid.ColumnSpan="3"/>
        <v:Banners Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"/>

        <DockPanel Grid.Row="2">
            <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Margin="0,0,0,8" AutomationProperties.Name="{loc:L inv_show}"/>
            <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}" Content="{loc:L inv_add}" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
            <TextBlock DockPanel.Dock="Top" Text="{loc:L inv_empty}" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding Items.Count, Converter={StaticResource HasValueVis}, ConverterParameter=invert}"/>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{loc:L nav_inventory}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11"><Run Text="{Binding Quantity, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding Place, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Status, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding Watering}" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding TreeInfo}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding EditIsTree, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{loc:L inv_water_now}" Command="{Binding WaterNowCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14" Visibility="{Binding EditIsTree, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:L tree_care}" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding Actions}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="{loc:L tree_effects}" Style="{StaticResource H2}" Margin="0,12,0,0"/>
                        <ItemsControl ItemsSource="{Binding Effects}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{loc:L tree_create_plan}" Command="{Binding CreateOnPlanCommand}" Margin="0,0,8,0"/>
                            <Button Content="{loc:L tree_show_designer}" Command="{Binding ShowInDesignerCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:L inv_details}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{loc:L design_name}" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:L design_name}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:L inv_species}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Species}" SelectedItem="{Binding EditSpecies}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L inv_variety}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditVariety}"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:L inv_where}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding EditLocation}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L inv_place}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditPlace}" ToolTip="{loc:L inv_place_tip}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="{loc:L inv_qty}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditQuantity}"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{loc:L inv_status}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding EditStatus}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{loc:L inv_interval}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditInterval}" ToolTip="{loc:L inv_interval_tip}"/></StackPanel>
                        </Grid>
                        <CheckBox Content="{loc:L inv_is_tree}" IsChecked="{Binding EditIsTree}" Margin="0,10,0,0"/>
                        <StackPanel Visibility="{Binding EditIsTree, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{loc:L tree_type}" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding TreeTypes}" SelectedItem="{Binding EditTreeType}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{loc:L tree_planted}" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding EditPlanted}"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{loc:L tree_height_cm}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditHeight}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{loc:L tree_crown}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditCrown}" ToolTip="{loc:L tree_crown_tip}"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="{loc:L tree_root}" Style="{StaticResource Label}"/><TextBox Text="{Binding EditRoot}" ToolTip="{loc:L tree_root_tip}"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{loc:L tree_plan_object}" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding TreeObjects}" SelectedItem="{Binding EditBed}"/>
                        </StackPanel>
                        <TextBlock Text="{loc:L space_notes}" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding EditNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{loc:L save}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource DangerButton}" Content="{loc:L delete}" Command="{Binding DeleteCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{loc:L inv_history}" Style="{StaticResource H2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding LogKinds}" SelectedItem="{Binding LogKind}" VerticalAlignment="Bottom"/>
                            <TextBox Grid.Column="2" Text="{Binding LogText}" VerticalAlignment="Bottom" AutomationProperties.Name="{loc:L animal_log_text}"/>
                            <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="{loc:L add}" Command="{Binding AddLogCommand}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Logs}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"><Run Text="{Binding Date, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Kind, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Text, Mode=OneWay}"/></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
