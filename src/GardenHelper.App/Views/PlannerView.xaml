<UserControl x:Class="GardenHelper.App.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" x:Name="Scroll">
        <StackPanel Margin="28,20,28,28" x:Name="Page">
            <TextBlock Text="{loc:L nav_planner}" Style="{StaticResource H1}"/>
            <TextBlock Text="{loc:L plan_sub}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"/>
            <v:Banners Margin="0,8,0,0"/>
            <WrapPanel Margin="0,10,0,0">
                <TextBlock Text="{loc:L season_year}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" MinWidth="90" Margin="0,0,16,0"/>
                <ComboBox ItemsSource="{Binding AllCrops}" SelectedItem="{Binding NewCrop}" MinWidth="200" Margin="0,0,8,0" AutomationProperties.Name="{loc:L plan_add_crop}"/>
                <Button Content="{loc:L plan_add_crop}" Command="{Binding AddCropCommand}" Margin="0,0,16,0" Padding="12,5"/>
                <Button Content="{loc:L print_button}" Click="OnPrint" Padding="12,5" ToolTip="{loc:L print_tip}"/>
            </WrapPanel>

            <!-- legend -->
            <WrapPanel Margin="0,10,0,6">
                <Border Background="#F2C94C" Width="14" Height="14" CornerRadius="4" Margin="0,0,4,0"/><TextBlock Text="{loc:L plan_k_sow_indoors}" Margin="0,0,14,0" FontSize="12"/>
                <Border Background="#8CC152" Width="14" Height="14" CornerRadius="4" Margin="0,0,4,0"/><TextBlock Text="{loc:L plan_k_sow_direct}" Margin="0,0,14,0" FontSize="12"/>
                <Border Background="#4FA3C7" Width="14" Height="14" CornerRadius="4" Margin="0,0,4,0"/><TextBlock Text="{loc:L plan_k_transplant}" Margin="0,0,14,0" FontSize="12"/>
                <Border Background="#E9875B" Width="14" Height="14" CornerRadius="4" Margin="0,0,4,0"/><TextBlock Text="{loc:L plan_k_harvest}" FontSize="12"/>
            </WrapPanel>

            <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Background="#FFEFF6E6" CornerRadius="18" Padding="20" Margin="0,8,0,0" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="{loc:L plan_empty}" TextWrapping="Wrap" Foreground="#FF40552F"/>
            </Border>

            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="840"/></Grid.ColumnDefinitions>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Months}" Margin="0,0,0,2">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="12" Foreground="#FF6C7A62"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="54">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="840"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <Border Grid.Column="1" Background="White" BorderBrush="#FFE3DCC8" BorderThickness="0,0,0,1" CornerRadius="6">
                                    <ItemsControl ItemsSource="{Binding Bars}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}"/><Setter Property="Canvas.Top" Value="{Binding Top}"/></Style></ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><Border Width="{Binding Width}" Height="14" CornerRadius="6" Background="{Binding Fill}" ToolTip="{Binding Tip}"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Canvas Margin="170,0,0,0" IsHitTestVisible="False" Width="840" HorizontalAlignment="Left" Visibility="{Binding ShowToday, Converter={StaticResource BoolToVis}}">
                    <Rectangle Canvas.Left="{Binding TodayLeft}" Width="2" Height="2000" Fill="#CCC0562B"/>
                </Canvas>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
