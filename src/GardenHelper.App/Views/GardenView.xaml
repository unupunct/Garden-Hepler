<UserControl x:Class="GardenHelper.App.Views.GardenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GardenHelper.App.Infrastructure"
             xmlns:v="clr-namespace:GardenHelper.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,26" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{loc:L nav_garden}" Style="{StaticResource H1}" Margin="0,0,0,6"/>
            <TextBlock Text="{loc:L garden_intro}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
            <v:Banners/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:L garden_name}" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{loc:L garden_country}" Style="{StaticResource Label}"/><TextBox Text="{Binding Country}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{loc:L garden_region}" Style="{StaticResource Label}"/><TextBox Text="{Binding Region}"/></StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:L garden_zone}" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Zone}" Width="160" HorizontalAlignment="Left"/>
                    <TextBlock Text="{loc:L garden_frost_title}" Style="{StaticResource H2}" Margin="0,22,0,2"/>
                    <TextBlock Text="{loc:L garden_frost_help}" Style="{StaticResource Muted}" FontSize="12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{loc:L garden_last_frost}" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding LastFrost}" AutomationProperties.Name="{loc:L garden_last_frost}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{loc:L garden_first_frost}" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding FirstFrost}" AutomationProperties.Name="{loc:L garden_first_frost}"/></StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:L garden_notes}" Style="{StaticResource Label}" Margin="0,16,0,3"/>
                    <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:L save}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
