<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>GardenHelper</AssemblyName>
    <RootNamespace>GardenHelper.App</RootNamespace>
    <ApplicationIcon>Assets\GardenHelper.ico</ApplicationIcon>
    <Version>0.2.1</Version>
    <Product>Garden Helper</Product>
    <Company>Garden Helper contributors</Company>
    <Description>Offline gardening, permaculture and self-sufficiency helper with a personal ebook knowledge base.</Description>
    <Copyright>Copyright © 2026 Garden Helper contributors</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- only for the notification (tray) icon: no implicit WinForms namespaces -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GardenHelper.Core\GardenHelper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GardenHelper.ico" />
    <!-- Knowledge-base content ships as plain JSON next to the executable (see docs/CONTENT.md). -->
    <!-- The phone web app is served by the local API (see docs/PHONE-AND-HOME-ASSISTANT.md). -->
    <!-- Books that come with the app (only redistributable ones; see content/starter-library/SOURCES.md). -->
    <Content Include="..\..\content\starter-library\*.pdf;..\..\content\starter-library\*.epub;..\..\content\starter-library\*.txt" Link="StarterLibrary\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\mobile\*" Link="Mobile\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Raspberry Pi agent and its first-time guide, opened from the Greenhouse page. -->
    <Content Include="..\..\tools\raspberry-pi\greenhouse_agent.py;..\..\tools\raspberry-pi\README.md" Link="tools\raspberry-pi\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\RASPBERRY-PI-SETUP.md;..\..\docs\RASPBERRY-PI-SETUP.ro.md" Link="docs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\content\**\*.json" Link="Content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
