<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Garden Helper light palette: ivory surfaces, forest green primary, terracotta accent. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F7F3E8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF8"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#E9EEDD"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2A1C"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#566350"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2F5D3A"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#264C30"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#B4532A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D6D0BC"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#1F3D2B"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#E8EFE0"/>
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="#9DB5A0"/>
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#33603F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#A32A1E"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#8A5A00"/>
    <SolidColorBrush x:Key="OkBrush" Color="#2F6B3A"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EFEBDB"/>
    <Color x:Key="ShadowColor">#000000</Color>
</ResourceDictionary>
